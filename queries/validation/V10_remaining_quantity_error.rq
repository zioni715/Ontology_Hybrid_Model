PREFIX pcpo: <https://example.org/pcpo#>

# V10: remainingQuantity != contractQuantity - cumulativeQuantity.
SELECT ?line ?contractQuantity ?cumulativeQuantity ?recordedRemainingQuantity ?expectedRemainingQuantity
WHERE {
  ?line a pcpo:CurrentProgressLine ;
        pcpo:basedOnContractItem ?item ;
        pcpo:cumulativeQuantityValue ?cumulativeQuantity ;
        pcpo:remainingQuantityValue ?recordedRemainingQuantity .
  ?item pcpo:contractQuantityValue ?contractQuantity .
  BIND(?contractQuantity - ?cumulativeQuantity AS ?expectedRemainingQuantity)
  FILTER(ABS(?recordedRemainingQuantity - ?expectedRemainingQuantity) > 0.0001)
}
ORDER BY ?line
