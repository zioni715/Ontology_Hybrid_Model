PREFIX pcpo: <https://example.org/pcpo#>

# V03: Item names on QTO/progress lines differ from their contract item.
SELECT ?line ?contractItemCode ?documentItemName ?contractItemName
WHERE {
  VALUES ?lineClass { pcpo:QuantityCalculationLine pcpo:CurrentProgressLine }
  ?line a ?lineClass ;
        pcpo:basedOnContractItem ?item ;
        pcpo:itemName ?documentItemName .
  ?item pcpo:contractItemCode ?contractItemCode ;
        pcpo:itemName ?contractItemName .
  FILTER(STR(?documentItemName) != STR(?contractItemName))
}
ORDER BY ?line
