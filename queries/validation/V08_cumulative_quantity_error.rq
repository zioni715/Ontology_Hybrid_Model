PREFIX pcpo: <https://example.org/pcpo#>

# V08: cumulativeQuantity != previousCumulativeQuantity + currentProgressQuantity.
SELECT ?line ?previousQuantity ?currentQuantity ?recordedCumulativeQuantity ?expectedCumulativeQuantity
WHERE {
  ?line a pcpo:CurrentProgressLine ;
        pcpo:previousCumulativeQuantityValue ?previousQuantity ;
        pcpo:currentProgressQuantityValue ?currentQuantity ;
        pcpo:cumulativeQuantityValue ?recordedCumulativeQuantity .
  BIND(?previousQuantity + ?currentQuantity AS ?expectedCumulativeQuantity)
  FILTER(ABS(?recordedCumulativeQuantity - ?expectedCumulativeQuantity) > 0.0001)
}
ORDER BY ?line
