PREFIX pcpo: <https://example.org/pcpo#>

# V13: Recorded summary amount differs from the sum of aggregated components.
SELECT ?summary ?recordedSummaryAmount (SUM(?componentAmount) AS ?expectedSummaryAmount)
WHERE {
  ?summary a pcpo:ProgressSummary ;
           pcpo:aggregatedCurrentAmountValue ?recordedSummaryAmount ;
           pcpo:aggregates ?component .
  {
    ?component pcpo:currentProgressAmountValue ?componentAmount .
  }
  UNION
  {
    ?component pcpo:aggregatedCurrentAmountValue ?componentAmount .
  }
}
GROUP BY ?summary ?recordedSummaryAmount
HAVING(ABS(?recordedSummaryAmount - SUM(?componentAmount)) > 0.5)
ORDER BY ?summary
