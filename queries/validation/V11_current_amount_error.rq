PREFIX pcpo: <https://example.org/pcpo#>

# V11: currentAmount != currentQuantity * effective contract unit price.
# The synthetic test tolerance is 0.5 KRW.
SELECT ?line ?currentQuantity ?contractUnitPrice ?recordedCurrentAmount ?expectedCurrentAmount
WHERE {
  ?line a pcpo:CurrentProgressLine ;
        pcpo:basedOnContractItem ?item ;
        pcpo:currentProgressQuantityValue ?currentQuantity ;
        pcpo:currentProgressAmountValue ?recordedCurrentAmount .
  ?item pcpo:contractUnitPriceValue ?contractUnitPrice .
  BIND(?currentQuantity * ?contractUnitPrice AS ?expectedCurrentAmount)
  FILTER(ABS(?recordedCurrentAmount - ?expectedCurrentAmount) > 0.5)
}
ORDER BY ?line
