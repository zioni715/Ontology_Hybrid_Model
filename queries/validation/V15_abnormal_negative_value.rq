PREFIX pcpo: <https://example.org/pcpo#>

# V15: Negative quantities/prices/amounts or cumulative quantity above contract quantity.
SELECT ?resource ?property ?value ?reason
WHERE {
  {
    VALUES ?property {
      pcpo:contractQuantityValue
      pcpo:contractUnitPriceValue
      pcpo:contractAmountValue
      pcpo:previousCumulativeQuantityValue
      pcpo:currentProgressQuantityValue
      pcpo:cumulativeQuantityValue
      pcpo:remainingQuantityValue
      pcpo:previousCumulativeAmountValue
      pcpo:currentProgressAmountValue
      pcpo:cumulativeAmountValue
      pcpo:aggregatedCurrentAmountValue
    }
    ?resource ?property ?value .
    FILTER(?value < 0)
    BIND("negative numeric value" AS ?reason)
  }
  UNION
  {
    ?resource a pcpo:CurrentProgressLine ;
              pcpo:basedOnContractItem ?item ;
              pcpo:cumulativeQuantityValue ?value .
    ?item pcpo:contractQuantityValue ?contractQuantity .
    FILTER(?value > ?contractQuantity + 0.0001)
    BIND(pcpo:cumulativeQuantityValue AS ?property)
    BIND("cumulative quantity exceeds contract quantity" AS ?reason)
  }
}
ORDER BY ?resource ?property
