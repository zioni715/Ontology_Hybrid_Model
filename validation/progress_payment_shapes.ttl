@prefix rcpp: <https://w3id.org/rcpp#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL 검증 규칙
#
# RDFS는 타입과 관계의 의미를 설명하지만 오류를 검출하지 않는다.
# 이 파일은 기성 비용 산정 데이터가 최소한의 필수 관계,
# 단위, 금액 계산 근거를 갖는지 검증하기 위한 Shape 모음이다.
#################################################################

rcpp:BusinessItemShape
    a sh:NodeShape ;
    sh:targetClass rcpp:BusinessItem ;
    sh:property [
        sh:path rcpp:canonicalItemCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "업무항목에는 정규 항목코드 canonicalItemCode가 정확히 하나 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:normalizedItemName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "업무항목에는 정규 항목명 normalizedItemName이 정확히 하나 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "업무항목에는 표준화된 수량 단위코드 unitCode가 정확히 하나 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:aboutWorkType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "업무항목은 정확히 하나의 공종 개념 IRI를 aboutWorkType으로 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:hasSpecification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:ItemSpecification ;
        sh:message "업무항목은 정확히 하나의 구조화 규격 노드를 hasSpecification으로 참조해야 한다."@ko
    ] .

rcpp:DocumentRowShape
    a sh:NodeShape ;
    sh:targetClass rcpp:DocumentRow ;
    sh:targetClass rcpp:ProgressStatementLineItem ;
    sh:targetClass rcpp:TradeDetailLineItem ;
    sh:targetClass rcpp:ContractBOQLineItem ;
    sh:property [
        sh:path rcpp:describesBusinessItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:BusinessItem ;
        sh:message "문서행은 정확히 하나의 업무항목을 describesBusinessItem으로 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:sourceLocation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "문서행에는 문서 내 위치 sourceLocation이 정확히 하나 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:itemCodeText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "문서행에는 문서 원문 항목코드 itemCodeText가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:itemNameText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "문서행에는 문서 원문 항목명 itemNameText가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:specificationText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "문서행에는 문서 원문 규격 specificationText가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "문서행에는 문서 원문 단위 unitText가 필요하다."@ko
    ] .

rcpp:NormalizedUnitCodeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rcpp:unitCode ;
    sh:property [
        sh:path rcpp:unitCode ;
        sh:datatype xsd:string ;
        sh:not [
            sh:in ( "ton" "TON" "톤" "m²" "㎡" "M2" "m³" "㎥" "M3" )
        ] ;
        sh:message "unitCode에는 ton, 톤, ㎡ 같은 원문 단위가 아니라 t, m2, m3 같은 정규화 코드를 사용해야 한다."@ko
    ] .

rcpp:RebarSpecificationShape
    a sh:NodeShape ;
    sh:targetClass rcpp:RebarSpecification ;
    sh:property [ sh:path rcpp:specificationText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "철근 규격에는 원문 규격 specificationText가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:steelGrade ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "철근 규격에는 강종 steelGrade가 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:barDesignation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "철근 규격에는 철근 호칭 barDesignation이 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:nominalDiameterValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "철근 규격에는 공칭직경 숫자값 nominalDiameterValue가 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:nominalDiameterUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "철근 규격에는 공칭직경 단위 nominalDiameterUnit이 정확히 하나 필요하다."@ko ] ;
    sh:sparql [
        sh:message "철근 호칭과 공칭직경 기준값이 일치해야 한다. D13=12.7 mm, D16=15.9 mm, D19=19.1 mm."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rcpp:barDesignation ?designation ;
                      rcpp:nominalDiameterValue ?diameter ;
                      rcpp:nominalDiameterUnit ?unit .
                FILTER(
                    (?designation = "D13" && (ABS(xsd:decimal(?diameter) - 12.7) > 0.001 || ?unit != "mm")) ||
                    (?designation = "D16" && (ABS(xsd:decimal(?diameter) - 15.9) > 0.001 || ?unit != "mm")) ||
                    (?designation = "D19" && (ABS(xsd:decimal(?diameter) - 19.1) > 0.001 || ?unit != "mm"))
                )
            }
        """
    ] .

rcpp:ConcreteSpecificationShape
    a sh:NodeShape ;
    sh:targetClass rcpp:ConcreteSpecification ;
    sh:property [ sh:path rcpp:specificationText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "콘크리트 규격에는 원문 규격 specificationText가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:concreteType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "콘크리트 규격에는 concreteType이 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:designStrengthValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "콘크리트 규격에는 설계기준압축강도 숫자값이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:designStrengthUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "콘크리트 규격에는 설계기준압축강도 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:aggregateMaxSizeValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "콘크리트 규격에는 굵은골재 최대치수 숫자값이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:aggregateMaxSizeUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "콘크리트 규격에는 굵은골재 최대치수 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:slumpValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "콘크리트 규격에는 슬럼프 숫자값이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:slumpUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "콘크리트 규격에는 슬럼프 단위가 필요하다."@ko ] .

rcpp:FormworkSpecificationShape
    a sh:NodeShape ;
    sh:targetClass rcpp:FormworkSpecification ;
    sh:property [ sh:path rcpp:specificationText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "거푸집 규격에는 원문 규격 specificationText가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:formworkMaterial ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "거푸집 규격에는 재료 formworkMaterial이 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:formworkType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "거푸집 규격에는 형식 formworkType이 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:contactMember ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "거푸집 규격에는 적용부재 contactMember가 정확히 하나 필요하다."@ko ] .

rcpp:ShoringSpecificationShape
    a sh:NodeShape ;
    sh:targetClass rcpp:ShoringSpecification ;
    sh:property [ sh:path rcpp:specificationText ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 규격에는 원문 규격 specificationText가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:shoringSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "동바리 규격에는 시스템 shoringSystem이 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:shoringHeight ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "동바리 규격에는 적용높이 shoringHeight가 정확히 하나 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:shoringHeightUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "동바리 규격에는 적용높이 단위 shoringHeightUnit이 정확히 하나 필요하다."@ko ] .

rcpp:ProgressPaymentSubmissionPackageShape
    a sh:NodeShape ;
    sh:targetClass rcpp:ProgressPaymentSubmissionPackage ;
    sh:targetClass rcpp:RcppProgressPaymentSubmissionPackage ;
    sh:property [
        sh:path rcpp:currencyCode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "기성제출서류패키지에는 금액 통화인 currencyCode가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:amountScale ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "기성제출서류패키지에는 금액 단위 스케일인 amountScale이 필요하다."@ko
    ] .

rcpp:ProgressStatementLineItemShape
    a sh:NodeShape ;
    sh:targetClass rcpp:ProgressStatementLineItem ;
    sh:property [
        sh:path rcpp:describesBusinessItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:BusinessItem ;
        sh:message "공사기성부분내역서 행은 정확히 하나의 업무항목을 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:derivedFrom ;
        sh:minCount 1 ;
        sh:class rcpp:TradeDetailLineItem ;
        sh:message "공사기성부분내역서 행은 원천 공종별내역서 행을 derivedFrom으로 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:currentQuantity ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공사기성부분내역서 행에는 금회수량이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitPrice ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공사기성부분내역서 행에는 단가가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:currentAmount ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공사기성부분내역서 행에는 금회금액이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:progressRate ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공사기성부분내역서 행에는 기성비율이 필요하다."@ko
    ] ;
    sh:sparql [
        sh:message "금회금액은 금회수량과 단가의 곱과 일치해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rcpp:currentQuantity ?quantity ;
                      rcpp:unitPrice ?unitPrice ;
                      rcpp:currentAmount ?amount .
                FILTER(ABS(xsd:decimal(?amount) - (xsd:decimal(?quantity) * xsd:decimal(?unitPrice))) > 0.001)
            }
        """
    ] ;
    sh:sparql [
        sh:message "기성비율은 누계수량 ÷ 계약수량과 일치해야 한다. progressRate는 0~1 비율값이다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rcpp:cumulativeQuantity ?cumulativeQuantity ;
                      rcpp:progressRate ?progressRate ;
                      rcpp:derivedFrom ?tradeDetailRow .
                ?tradeDetailRow rcpp:correspondsToContractItem ?contractItem .
                ?contractItem rcpp:contractQuantity ?contractQuantity .
                FILTER(?contractQuantity != 0)
                FILTER(ABS(xsd:decimal(?progressRate) - (xsd:decimal(?cumulativeQuantity) / xsd:decimal(?contractQuantity))) > 0.001)
            }
        """
    ] .

rcpp:TradeDetailLineItemShape
    a sh:NodeShape ;
    sh:targetClass rcpp:TradeDetailLineItem ;
    sh:property [
        sh:path rcpp:describesBusinessItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:BusinessItem ;
        sh:message "공종별내역서 행은 정확히 하나의 업무항목을 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:currentQuantity ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공종별내역서 행에는 금회수량이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:currentAmount ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "공종별내역서 행에는 금회금액이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:correspondsToContractItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:ContractBOQLineItem ;
        sh:message "공종별내역서 행은 계약산출내역서 행과 정확히 하나 대응해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:hasQuantityBasis ;
        sh:minCount 1 ;
        sh:class rcpp:QuantityCalculationItem ;
        sh:message "공종별내역서 행은 하나 이상의 수량산출 근거를 가져야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:hasUnitPriceBasis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:UnitPriceItem ;
        sh:message "공종별내역서 행은 적용 단가 근거를 정확히 하나 가져야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:aggregatedInto ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:SummaryLineItem ;
        sh:message "공종별내역서 행은 공종별집계표 집계항목으로 aggregatedInto 되어야 한다."@ko
    ] ;
    sh:sparql [
        sh:message "공종별내역서 행과 계약산출내역서 행은 같은 업무항목을 참조해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            SELECT $this
            WHERE {
                $this rcpp:describesBusinessItem ?businessItem ;
                      rcpp:correspondsToContractItem ?contractItem .
                ?contractItem rcpp:describesBusinessItem ?contractBusinessItem .
                FILTER(?businessItem != ?contractBusinessItem)
            }
        """
    ] ;
    sh:sparql [
        sh:message "공종별내역서 행과 수량산출항목은 같은 업무항목을 참조해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            SELECT $this
            WHERE {
                $this rcpp:describesBusinessItem ?businessItem ;
                      rcpp:hasQuantityBasis ?quantityItem .
                ?quantityItem rcpp:forBusinessItem ?quantityBusinessItem .
                FILTER(?businessItem != ?quantityBusinessItem)
            }
        """
    ] ;
    sh:sparql [
        sh:message "공종별내역서 행과 단가항목은 같은 업무항목을 참조해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            SELECT $this
            WHERE {
                $this rcpp:describesBusinessItem ?businessItem ;
                      rcpp:hasUnitPriceBasis ?unitPriceItem .
                ?unitPriceItem rcpp:forBusinessItem ?unitPriceBusinessItem .
                FILTER(?businessItem != ?unitPriceBusinessItem)
            }
        """
    ] .

rcpp:QuantityCalculationItemShape
    a sh:NodeShape ;
    sh:targetClass rcpp:QuantityCalculationItem ;
    sh:property [
        sh:path rcpp:forBusinessItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:BusinessItem ;
        sh:message "수량산출항목은 정확히 하나의 업무항목을 forBusinessItem으로 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitCode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 내역서 수량과 비교할 unitCode가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:documentedQuantity ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "수량산출항목에는 문서기재수량이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:derivedQuantity ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "수량산출항목에는 속성값으로 검산한 파생수량이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:quantityDifference ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "수량산출항목에는 문서기재수량과 파생수량의 차이가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:calculationFormula ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 계산식이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:differenceDirection ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 수량차이의 방향이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:toleranceValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "수량산출항목에는 허용오차값이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:toleranceUnit ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 허용오차 단위가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:validationStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 검증상태가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:roundingRule ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "수량산출항목에는 반올림 규칙이 필요하다."@ko
    ] .

rcpp:RebarQuantityCalculationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rcpp:barLength ;
    sh:property [ sh:path rcpp:barLength ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "철근 수량산출항목에는 철근 길이가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:barLengthUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "철근 길이에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:barCount ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:message "철근 수량산출항목에는 본수가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:unitWeight ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "철근 수량산출항목에는 단위중량이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:unitWeightUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "철근 단위중량에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:totalBarLength ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "철근 수량산출항목에는 총길이가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:totalBarLengthUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "철근 총길이에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:rebarWeight ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "철근 수량산출항목에는 철근중량이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:rebarWeightUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "철근중량에는 단위가 필요하다."@ko ] .

