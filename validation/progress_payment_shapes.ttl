    sh:property [ sh:path rcpp:grossContactArea ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "거푸집 수량산출항목에는 총 접촉면적이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:netContactArea ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "거푸집 수량산출항목에는 순 접촉면적이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:areaUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "거푸집 면적에는 단위가 필요하다."@ko ] .

rcpp:ShoringQuantityCalculationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rcpp:installedVolume ;
    sh:property [ sh:path rcpp:measurementMethod ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 수량산출항목에는 측정방식이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportLength ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "동바리 수량산출항목에는 지지면 길이가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportLengthUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 지지면 길이에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportWidth ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "동바리 수량산출항목에는 지지면 폭이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportWidthUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 지지면 폭에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportArea ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "동바리 수량산출항목에는 지지면적이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:supportAreaUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 지지면적에는 단위가 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:installedVolume ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "동바리 수량산출항목에는 설치체적이 필요하다."@ko ] ;
    sh:property [ sh:path rcpp:installedVolumeUnit ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "동바리 설치체적에는 단위가 필요하다."@ko ] .

rcpp:UnitPriceItemShape
    a sh:NodeShape ;
    sh:targetObjectsOf rcpp:hasUnitPriceBasis ;
    sh:property [
        sh:path rcpp:forBusinessItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rcpp:BusinessItem ;
        sh:message "단가항목은 정확히 하나의 업무항목을 forBusinessItem으로 참조해야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitCode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "단가항목에는 단가 적용 단위인 unitCode가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:unitPrice ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "단가항목에는 unitPrice가 필요하다."@ko
    ] .

rcpp:SummaryLineItemShape
    a sh:NodeShape ;
    sh:targetClass rcpp:SummaryLineItem ;
    sh:or (
        [
            sh:property [
                sh:path rcpp:summarizesWorkType ;
                sh:minCount 1 ;
                sh:class rcpp:WorkType ;
                sh:message "공종별 집계항목은 summarizesWorkType으로 공종을 참조해야 한다."@ko
            ]
        ]
        [
            sh:property [
                sh:path rcpp:aggregatesBusinessItem ;
                sh:minCount 1 ;
                sh:class rcpp:BusinessItem ;
                sh:message "업무항목별 집계항목은 aggregatesBusinessItem으로 업무항목을 참조해야 한다."@ko
            ]
        ]
    ) ;
    sh:property [
        sh:path rcpp:currentAmount ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "집계항목에는 집계 금회금액이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:isCalculatedFrom ;
        sh:minCount 1 ;
        sh:class rcpp:TradeDetailLineItem ;
        sh:message "집계항목은 계산 입력이 되는 공종별내역서 행을 참조해야 한다."@ko
    ] ;
    sh:sparql [
        sh:message "집계항목 금액은 입력 공종별내역서 행의 금회금액 합계와 일치해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rcpp:currentAmount ?amount .
                {
                    SELECT $this (SUM(xsd:decimal(?lineAmount)) AS ?sumAmount)
                    WHERE {
                        $this rcpp:isCalculatedFrom ?lineItem .
                        ?lineItem rcpp:currentAmount ?lineAmount .
                    }
                    GROUP BY $this
                }
                FILTER(ABS(xsd:decimal(?amount) - ?sumAmount) > 0.001)
            }
        """
    ] .

rcpp:CostAmountShape
    a sh:NodeShape ;
    sh:targetClass rcpp:DirectConstructionCost ;
    sh:targetClass rcpp:IndirectConstructionCost ;
    sh:targetClass rcpp:StatutoryExpense ;
    sh:targetClass rcpp:GeneralAdministrationCost ;
    sh:targetClass rcpp:Profit ;
    sh:targetClass rcpp:ValueAddedTax ;
    sh:targetClass rcpp:SubtotalAmount ;
    sh:targetClass rcpp:TotalAmount ;
    sh:property [
        sh:path rcpp:amountValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "원가항목 또는 집계값에는 amountValue가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:isCalculatedFrom ;
        sh:minCount 1 ;
        sh:message "원가항목 또는 집계값은 계산 입력을 isCalculatedFrom으로 가져야 한다."@ko
    ] ;
    sh:property [
        sh:path rcpp:calculationFormula ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "원가항목 또는 집계값에는 계산식이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:computedBy ;
        sh:minCount 1 ;
        sh:class rcpp:CalculationRule ;
        sh:message "원가항목 또는 집계값은 계산규칙을 computedBy로 참조해야 한다."@ko
    ] .

rcpp:CostRateShape
    a sh:NodeShape ;
    sh:targetClass rcpp:RateCalculation ;
    sh:property [
        sh:path rcpp:rateValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "요율계산 규칙에는 rateValue가 필요하다."@ko
    ] .

rcpp:CalculationRuleShape
    a sh:NodeShape ;
    sh:targetClass rcpp:CalculationRule ;
    sh:targetClass rcpp:SumCalculation ;
    sh:targetClass rcpp:RateCalculation ;
    sh:property [
        sh:path rcpp:calculationOperator ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "계산규칙에는 calculationOperator가 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:hasBaseAmount ;
        sh:minCount 1 ;
        sh:message "계산규칙에는 하나 이상의 기준 금액 또는 기준 항목이 필요하다."@ko
    ] ;
    sh:property [
        sh:path rcpp:produces ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "계산규칙은 산출 결과를 produces로 정확히 하나 참조해야 한다."@ko
    ] .

rcpp:DirectConstructionCostCalculationShape
    a sh:NodeShape ;
    sh:targetClass rcpp:DirectConstructionCost ;
    sh:sparql [
        sh:message "직접공사비는 공종별 집계항목 금액의 합과 일치해야 한다."@ko ;
        sh:select """
            PREFIX rcpp: <https://w3id.org/rcpp#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rcpp:amountValue ?amount .
                {
                    SELECT $this (SUM(xsd:decimal(?summaryAmount)) AS ?sumAmount)
                    WHERE {
                        $this rcpp:isCalculatedFrom ?summaryItem .
                        ?summaryItem rcpp:currentAmount ?summaryAmount .
                    }
                    GROUP BY $this
                }
                FILTER(ABS(xsd:decimal(?amount) - ?sumAmount) > 0.001)
            }
        """
    ] .
