@prefix pcpo: <https://example.org/pcpo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Units
#################################################################

pcpo:Unit-TON a pcpo:Unit ;
    rdfs:label "톤"@ko , "tonne"@en ;
    pcpo:unitCode "t" .

pcpo:Unit-KG a pcpo:Unit ;
    rdfs:label "킬로그램"@ko , "kilogram"@en ;
    pcpo:unitCode "kg" .

pcpo:Unit-M a pcpo:Unit ;
    rdfs:label "미터"@ko , "metre"@en ;
    pcpo:unitCode "m" .

pcpo:Unit-M2 a pcpo:Unit ;
    rdfs:label "제곱미터"@ko , "square metre"@en ;
    pcpo:unitCode "m2" .

pcpo:Unit-M3 a pcpo:Unit ;
    rdfs:label "세제곱미터"@ko , "cubic metre"@en ;
    pcpo:unitCode "m3" .

pcpo:Unit-SPACE-M3 a pcpo:Unit ;
    rdfs:label "공세제곱미터"@ko , "spatial cubic metre"@en ;
    pcpo:unitCode "space-m3" .

pcpo:Unit-EACH a pcpo:Unit ;
    rdfs:label "개소"@ko , "location count"@en ;
    pcpo:unitCode "each" .

pcpo:Unit-LOT a pcpo:Unit ;
    rdfs:label "식"@ko , "lot"@en ;
    pcpo:unitCode "lot" .

#################################################################
# Calculation rules
#################################################################

pcpo:ContractAmountRule a pcpo:CalculationRule ;
    rdfs:label "계약금액 계산규칙"@ko , "Contract amount rule"@en ;
    pcpo:calculationExpression "contractAmount = contractQuantity * contractUnitPrice" ;
    pcpo:amountToleranceValue "0.5"^^xsd:decimal ;
    pcpo:roundingRuleText "원 단위 처리 방식은 기관 또는 현장 기준을 별도 적용하며 예제 검증 허용오차는 0.5원이다."@ko .

pcpo:CumulativeQuantityRule a pcpo:CalculationRule ;
    rdfs:label "누계수량 계산규칙"@ko , "Cumulative quantity rule"@en ;
    pcpo:calculationExpression "cumulativeQuantity = previousCumulativeQuantity + currentProgressQuantity" ;
    pcpo:quantityToleranceValue "0.0001"^^xsd:decimal .

pcpo:RemainingQuantityRule a pcpo:CalculationRule ;
    rdfs:label "잔여수량 계산규칙"@ko , "Remaining quantity rule"@en ;
    pcpo:calculationExpression "remainingQuantity = effectiveContractQuantity - cumulativeQuantity" ;
    pcpo:quantityToleranceValue "0.0001"^^xsd:decimal .

pcpo:CurrentProgressAmountRule a pcpo:CalculationRule ;
    rdfs:label "금회기성액 계산규칙"@ko , "Current progress amount rule"@en ;
    pcpo:calculationExpression "currentProgressAmount = currentProgressQuantity * effectiveContractUnitPrice" ;
    pcpo:amountToleranceValue "0.5"^^xsd:decimal ;
    pcpo:roundingRuleText "예제 데이터는 소수점 없는 원 단위 결과를 사용하며 실제 절사 또는 반올림은 발주기관 기준을 적용한다."@ko .

pcpo:CumulativeAmountRule a pcpo:CalculationRule ;
    rdfs:label "누계기성액 계산규칙"@ko , "Cumulative progress amount rule"@en ;
    pcpo:calculationExpression "cumulativeAmount = previousCumulativeAmount + currentProgressAmount" ;
    pcpo:amountToleranceValue "0.5"^^xsd:decimal .

pcpo:SubworkSummaryRule a pcpo:CalculationRule ;
    rdfs:label "세부공종 집계규칙"@ko , "Sub-work summary rule"@en ;
    pcpo:calculationExpression "subworkCurrentAmount = SUM(currentProgressAmount of sub-work items)" ;
    pcpo:amountToleranceValue "0.5"^^xsd:decimal .

pcpo:ReinforcedConcreteSummaryRule a pcpo:CalculationRule ;
    rdfs:label "철근콘크리트공종 집계규칙"@ko , "Reinforced concrete summary rule"@en ;
    pcpo:calculationExpression "reinforcedConcreteCurrentAmount = rebar + concrete + formwork + shoring" ;
    pcpo:amountToleranceValue "0.5"^^xsd:decimal .

pcpo:ReinforcedConcreteWorkItem pcpo:hasSubWorkType
    pcpo:RebarWorkItem , pcpo:ConcreteWorkItem , pcpo:FormworkWorkItem , pcpo:ShoringWorkItem .
