@prefix pcpo: <https://example.org/pcpo#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Object-linking properties
#################################################################

pcpo:hasContractVersion a rdf:Property ; rdfs:domain pcpo:Contract ; rdfs:range pcpo:ContractVersion ;
    rdfs:label "계약버전 보유"@ko , "has contract version"@en ; rdfs:comment "계약을 그 계약의 최초 또는 변경 버전에 연결한다."@ko .
pcpo:hasContractItem a rdf:Property ; rdfs:domain pcpo:ContractVersion ; rdfs:range pcpo:ContractItem ;
    rdfs:label "계약항목 보유"@ko , "has contract item"@en ; rdfs:comment "계약버전에 포함된 계약공사항목을 연결한다."@ko .
pcpo:hasDocumentLine a rdf:Property ; rdfs:domain pcpo:Document ; rdfs:range pcpo:DocumentLine ;
    rdfs:label "문서항목 보유"@ko , "has document line"@en ; rdfs:comment "문서를 그 문서에 기록된 행 또는 항목에 연결한다."@ko .
pcpo:representsContractItem a rdf:Property ; rdfs:domain pcpo:ContractDocumentLine ; rdfs:range pcpo:ContractItem ;
    rdfs:label "계약항목 표현"@ko , "represents contract item"@en ; rdfs:comment "계약문서의 행이 표현하는 현실의 계약공사항목을 연결한다."@ko .
pcpo:belongsToProject a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range pcpo:ConstructionProject ;
    rdfs:label "프로젝트 소속"@ko , "belongs to project"@en ; rdfs:comment "계약, 문서 또는 기성청구가 속한 프로젝트를 연결한다."@ko .
pcpo:belongsToContract a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range pcpo:Contract ;
    rdfs:label "계약 소속"@ko , "belongs to contract"@en ; rdfs:comment "계약버전, 항목 또는 문서를 관련 계약에 연결한다."@ko .
pcpo:belongsToContractVersion a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range pcpo:ContractVersion ;
    rdfs:label "계약버전 소속"@ko , "belongs to contract version"@en ; rdfs:comment "계약공사항목이 어느 계약버전에 정의되었는지 나타낸다."@ko .
pcpo:classifiedAsWorkType a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range rdfs:Class ;
    rdfs:label "공종 분류"@ko , "classified as work type"@en ; rdfs:comment "계약공사항목을 RDFS 공종 클래스 URI에 명시적으로 연결한다."@ko .
pcpo:summarizesWorkType a rdf:Property ; rdfs:domain pcpo:ProgressSummary ; rdfs:range rdfs:Class ;
    rdfs:label "집계 공종"@ko , "summarizes work type"@en ; rdfs:comment "기성금액 집계가 합산하여 나타내는 세부공종 또는 상위 공종 클래스를 연결한다."@ko .
pcpo:hasSubWorkType a rdf:Property ; rdfs:domain rdfs:Class ; rdfs:range rdfs:Class ;
    rdfs:label "하위공종 보유"@ko , "has sub-work type"@en ; rdfs:comment "상위 공종 클래스를 하위 공종 클래스에 연결하는 탐색용 관계이며 클래스 계층의 기준은 rdfs:subClassOf이다."@ko .
pcpo:hasSpecification a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range pcpo:Specification ;
    rdfs:label "규격 보유"@ko , "has specification"@en ; rdfs:comment "계약공사항목을 구조화된 규격 자원에 연결한다."@ko .
pcpo:hasUnit a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range pcpo:Unit ;
    rdfs:label "단위 보유"@ko , "has unit"@en ; rdfs:comment "수량을 기록하는 항목을 명시적 단위 코드에 연결한다."@ko .
pcpo:calculatedBy a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range pcpo:CalculationRule ;
    rdfs:label "계산규칙"@ko , "calculated by"@en ; rdfs:comment "파생값 또는 집계값을 생성한 계산규칙을 연결한다."@ko .
pcpo:derivedFrom a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource ;
    rdfs:label "파생 원천"@ko , "derived from"@en ; rdfs:comment "계산 또는 변환으로 생성된 값이나 항목의 직접 원천을 연결한다."@ko .
pcpo:basedOnContractItem a rdf:Property ; rdfs:domain pcpo:DocumentLine ; rdfs:range pcpo:ContractItem ;
    rdfs:label "계약항목 기준"@ko , "based on contract item"@en ; rdfs:comment "수량산출 또는 기성문서항목이 기준으로 삼은 계약공사항목을 연결한다."@ko .
pcpo:correspondsTo a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource ;
    rdfs:label "대응 관계"@ko , "corresponds to"@en ; rdfs:comment "서로 다른 문서의 대응 행 또는 계약버전별 대응 계약항목을 연결한다."@ko .
pcpo:carriedForwardFrom a rdf:Property ; rdfs:domain pcpo:CurrentProgressLine ; rdfs:range pcpo:PreviousProgressLine ;
    rdfs:label "전회 승인값 이월"@ko , "carried forward from"@en ; rdfs:comment "금회 기성항목의 전회 누계값이 어느 승인 항목에서 이월되었는지 나타낸다."@ko .
pcpo:aggregates a rdf:Property ; rdfs:domain pcpo:ProgressSummary ; rdfs:range rdfs:Resource ;
    rdfs:label "집계 대상"@ko , "aggregates"@en ; rdfs:comment "공종별 또는 전체 집계가 합산하는 세부 기성항목이나 하위 집계를 연결한다."@ko .
pcpo:supersedes a rdf:Property ; rdfs:domain pcpo:RevisedContractVersion ; rdfs:range pcpo:ContractVersion ;
    rdfs:label "이전 계약버전 대체"@ko , "supersedes"@en ; rdfs:comment "변경 계약버전이 대체하는 이전 계약버전을 연결한다."@ko .
pcpo:hasProgressRound a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range pcpo:ProgressPeriod ;
    rdfs:label "기성차수"@ko , "has progress round"@en ; rdfs:comment "문서, 청구 또는 기성항목을 해당 기성 회차에 연결한다."@ko .
pcpo:hasConstructionLocation a rdf:Property ; rdfs:domain pcpo:QuantityCalculationLine ; rdfs:range pcpo:ConstructionLocation ;
    rdfs:label "시공위치"@ko , "has construction location"@en ; rdfs:comment "수량산출항목을 해당 공사 위치에 연결한다."@ko .
pcpo:hasStructuralMember a rdf:Property ; rdfs:domain pcpo:QuantityCalculationLine ; rdfs:range pcpo:StructuralMember ;
    rdfs:label "구조부재"@ko , "has structural member"@en ; rdfs:comment "수량산출항목을 대상 구조부재에 연결한다."@ko .
pcpo:recordedIn a rdf:Property ; rdfs:domain pcpo:DocumentLine ; rdfs:range pcpo:Document ;
    rdfs:label "기록 문서"@ko , "recorded in"@en ; rdfs:comment "특정 문서항목이 실제로 기록된 문서를 연결한다."@ko .
pcpo:hasProgressClaimItem a rdf:Property ; rdfs:domain pcpo:ProgressClaim ; rdfs:range pcpo:ProgressClaimItem ;
    rdfs:label "기성청구항목 보유"@ko , "has progress claim item"@en ; rdfs:comment "기성청구를 그 회차의 세부 기성항목에 연결한다."@ko .

#################################################################
# Identifiers, text, dates, and flags
#################################################################

pcpo:namespaceUri a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:anyURI ;
    rdfs:label "네임스페이스 URI"@ko , "namespace URI"@en ; rdfs:comment "프로젝트에서 사용하는 기본 네임스페이스 문자열."@ko .
pcpo:projectIdentifier a rdf:Property ; rdfs:domain pcpo:ConstructionProject ; rdfs:range xsd:string ;
    rdfs:label "공사 식별자"@ko , "project identifier"@en ; rdfs:comment "공공공사를 구분하는 프로젝트 식별자."@ko .
pcpo:contractIdentifier a rdf:Property ; rdfs:domain pcpo:Contract ; rdfs:range xsd:string ;
    rdfs:label "계약 식별자"@ko , "contract identifier"@en ; rdfs:comment "공사 계약을 구분하는 식별자."@ko .
pcpo:contractVersionNumber a rdf:Property ; rdfs:domain pcpo:ContractVersion ; rdfs:range xsd:integer ;
    rdfs:label "계약버전 번호"@ko , "contract version number"@en ; rdfs:comment "최초 계약은 1, 변경 계약은 증가값으로 표현하는 버전 번호."@ko .
pcpo:documentIdentifier a rdf:Property ; rdfs:domain pcpo:Document ; rdfs:range xsd:string ;
    rdfs:label "문서 식별자"@ko , "document identifier"@en ; rdfs:comment "문서 또는 시트를 구분하는 식별자."@ko .
pcpo:lineIdentifier a rdf:Property ; rdfs:domain pcpo:DocumentLine ; rdfs:range xsd:string ;
    rdfs:label "문서항목 식별자"@ko , "line identifier"@en ; rdfs:comment "문서 안의 행 또는 항목을 구분하는 식별자."@ko .
pcpo:contractItemCode a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ;
    rdfs:label "계약항목코드"@ko , "contract item code"@en ; rdfs:comment "문서 간 동일 항목 연결에 우선 사용하는 계약항목 식별 코드."@ko .
pcpo:itemName a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ;
    rdfs:label "품명"@ko , "item name"@en ; rdfs:comment "계약공사항목 또는 문서행에 기록된 품명 문자열."@ko .
pcpo:specificationText a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ;
    rdfs:label "규격 문자열"@ko , "specification text"@en ; rdfs:comment "원문 문서의 규격 표현을 보존하는 문자열."@ko .
pcpo:unitCode a rdf:Property ; rdfs:domain pcpo:Unit ; rdfs:range xsd:string ;
    rdfs:label "단위코드"@ko , "unit code"@en ; rdfs:comment "단위 자원의 기계 판독 가능한 코드."@ko .
pcpo:locationName a rdf:Property ; rdfs:domain pcpo:ConstructionLocation ; rdfs:range xsd:string ;
    rdfs:label "위치명"@ko , "location name"@en ; rdfs:comment "현장 또는 도면에서 사용하는 시공 위치명."@ko .
pcpo:memberName a rdf:Property ; rdfs:domain pcpo:StructuralMember ; rdfs:range xsd:string ;
    rdfs:label "부재명"@ko , "member name"@en ; rdfs:comment "수량산출 대상 구조부재명."@ko .
pcpo:validFrom a rdf:Property ; rdfs:domain pcpo:ContractVersion ; rdfs:range xsd:date ;
    rdfs:label "적용 시작일"@ko , "valid from"@en ; rdfs:comment "계약버전의 효력이 시작되는 날짜."@ko .
pcpo:validTo a rdf:Property ; rdfs:domain pcpo:ContractVersion ; rdfs:range xsd:date ;
    rdfs:label "적용 종료일"@ko , "valid to"@en ; rdfs:comment "계약버전의 효력이 종료되는 날짜."@ko .
pcpo:progressRoundNumber a rdf:Property ; rdfs:domain pcpo:ProgressPeriod ; rdfs:range xsd:integer ;
    rdfs:label "기성차수 번호"@ko , "progress round number"@en ; rdfs:comment "제1회, 제2회 등의 기성차수를 정수로 표현한 값."@ko .
pcpo:progressReferenceDate a rdf:Property ; rdfs:domain pcpo:ProgressPeriod ; rdfs:range xsd:date ;
    rdfs:label "기성 기준일"@ko , "progress reference date"@en ; rdfs:comment "유효 계약버전을 선택하는 기준이 되는 기성일."@ko .
pcpo:isApproved a rdf:Property ; rdfs:domain pcpo:ProgressClaim ; rdfs:range xsd:boolean ;
    rdfs:label "승인 여부"@ko , "is approved"@en ; rdfs:comment "기성청구가 승인된 값인지 나타낸다."@ko .

#################################################################
# Contract, progress, and derived numeric values
#################################################################

pcpo:contractQuantityValue a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range xsd:decimal ;
    rdfs:label "계약수량"@ko , "contract quantity"@en ; rdfs:comment "해당 계약버전에서 유효한 계약수량 원천값."@ko .
pcpo:contractUnitPriceValue a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range xsd:decimal ;
    rdfs:label "계약단가"@ko , "contract unit price"@en ; rdfs:comment "해당 계약버전에서 유효한 계약단가 원천값."@ko .
pcpo:contractAmountValue a rdf:Property ; rdfs:domain pcpo:ContractItem ; rdfs:range xsd:decimal ;
    rdfs:label "계약금액"@ko , "contract amount"@en ; rdfs:comment "계약수량과 계약단가를 곱하여 계산한 파생 계약금액."@ko .
pcpo:previousCumulativeQuantityValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "전회 누계기성수량"@ko , "previous cumulative quantity"@en ; rdfs:comment "전회 승인 내역서에서 금회로 이월되는 누계수량 원천값."@ko .
pcpo:currentProgressQuantityValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "금회기성수량"@ko , "current progress quantity"@en ; rdfs:comment "금회 기성수량산출서가 제공하는 현재 회차 수량 원천값."@ko .
pcpo:cumulativeQuantityValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "누계기성수량"@ko , "cumulative quantity"@en ; rdfs:comment "전회 누계수량과 금회수량을 더하여 계산한 파생값."@ko .
pcpo:remainingQuantityValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "잔여수량"@ko , "remaining quantity"@en ; rdfs:comment "유효 계약수량에서 누계기성수량을 차감한 파생값."@ko .
pcpo:appliedContractUnitPriceValue a rdf:Property ; rdfs:domain pcpo:CurrentProgressLine ; rdfs:range xsd:decimal ;
    rdfs:label "적용 계약단가"@ko , "applied contract unit price"@en ; rdfs:comment "금회 기성항목에 실제로 기록하여 적용한 계약단가."@ko .
pcpo:previousCumulativeAmountValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "전회 누계기성액"@ko , "previous cumulative amount"@en ; rdfs:comment "전회 승인 내역서에서 이월되는 누계금액 원천값."@ko .
pcpo:currentProgressAmountValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "금회기성액"@ko , "current progress amount"@en ; rdfs:comment "금회기성수량과 유효 계약단가를 곱한 파생 금액."@ko .
pcpo:cumulativeAmountValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ;
    rdfs:label "누계기성액"@ko , "cumulative progress amount"@en ; rdfs:comment "전회 누계기성액과 금회기성액을 더한 파생 금액."@ko .
pcpo:aggregatedCurrentAmountValue a rdf:Property ; rdfs:domain pcpo:ProgressSummary ; rdfs:range xsd:decimal ;
    rdfs:label "집계 금회기성액"@ko , "aggregated current amount"@en ; rdfs:comment "집계 대상의 금회기성액을 합산한 파생 금액."@ko .
pcpo:calculationExpression a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ;
    rdfs:label "산출식"@ko , "calculation expression"@en ; rdfs:comment "원문 산출식 또는 계산규칙을 사람이 읽을 수 있게 보존한 문자열."@ko .
pcpo:quantityToleranceValue a rdf:Property ; rdfs:domain pcpo:CalculationRule ; rdfs:range xsd:decimal ;
    rdfs:label "수량 허용오차"@ko , "quantity tolerance"@en ; rdfs:comment "수량 계산 검증 시 동일하다고 판단하는 최대 차이."@ko .
pcpo:amountToleranceValue a rdf:Property ; rdfs:domain pcpo:CalculationRule ; rdfs:range xsd:decimal ;
    rdfs:label "금액 허용오차"@ko , "amount tolerance"@en ; rdfs:comment "금액 계산 검증 시 동일하다고 판단하는 최대 원 단위 차이."@ko .
pcpo:roundingRuleText a rdf:Property ; rdfs:domain pcpo:CalculationRule ; rdfs:range xsd:string ;
    rdfs:label "반올림 규칙"@ko , "rounding rule"@en ; rdfs:comment "기관 또는 현장별 원 단위 절사와 반올림 규칙을 설명한다."@ko .

#################################################################
# Trade-specific optional attributes
#################################################################

pcpo:steelGrade a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ; rdfs:label "철근 강종"@ko , "steel grade"@en ; rdfs:comment "철근 규격의 강종."@ko .
pcpo:barDiameterValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "철근 직경"@ko , "bar diameter"@en ; rdfs:comment "철근 직경 숫자값이며 단위는 별도 관리한다."@ko .
pcpo:barShapeCode a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:string ; rdfs:label "철근 형상코드"@ko , "bar shape code"@en ; rdfs:comment "철근 형상 또는 가공 형상을 나타내는 코드."@ko .
pcpo:barCount a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:integer ; rdfs:label "철근 개수"@ko , "bar count"@en ; rdfs:comment "수량산출에 사용된 철근 본수."@ko .
pcpo:barLengthValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "철근 1본 길이"@ko , "bar length"@en ; rdfs:comment "철근 한 본의 산출 길이."@ko .
pcpo:baseLengthValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "기본 길이"@ko , "base length"@en ; rdfs:comment "이음과 정착을 제외한 기본 철근 길이."@ko .
pcpo:spliceLengthValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "이음 길이"@ko , "splice length"@en ; rdfs:comment "철근 이음에 추가되는 길이."@ko .
pcpo:anchorageLengthValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "정착 길이"@ko , "anchorage length"@en ; rdfs:comment "정착 또는 갈고리에 추가되는 길이."@ko .
pcpo:totalBarLengthValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "총 철근 길이"@ko , "total bar length"@en ; rdfs:comment "철근 개수와 한 본 길이로 계산한 총길이."@ko .
pcpo:unitWeightValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "단위중량"@ko , "unit weight"@en ; rdfs:comment "직경별 철근 길이 단위당 중량."@ko .
pcpo:rebarWeightValue a rdf:Property ; rdfs:domain rdfs:Resource ; rdfs:range xsd:decimal ; rdfs:label "철근 중량"@ko , "rebar weight"@en ; rdfs:comment "총 철근 길이와 단위중량으로 계산한 중량."@ko .

