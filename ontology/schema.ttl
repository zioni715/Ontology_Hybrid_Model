@prefix pcpo: <https://example.org/pcpo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pcpo:OntologySchema
    a rdfs:Resource ;
    dcterms:title "공공공사 철근콘크리트공종 기성금액 산정 온톨로지"@ko ,
        "Public Construction Progress Payment Ontology"@en ;
    dcterms:description "유효 계약정보, 금회기성수량, 전회 승인 누계값과 공종별 집계를 RDF/RDFS로 연결하는 기초 온톨로지."@ko ;
    dcterms:identifier "PCPO" ;
    dcterms:hasVersion "1.0.0" ;
    dcterms:created "2026-07-16"^^xsd:date ;
    pcpo:namespaceUri "https://example.org/pcpo#"^^xsd:anyURI ;
    rdfs:seeAlso pcpo:ClassesModule , pcpo:PropertiesModule , pcpo:CodeListsModule .

pcpo:ClassesModule
    a rdfs:Resource ;
    rdfs:label "클래스 모듈"@ko , "Classes module"@en ;
    rdfs:comment "ontology/classes.ttl에 정의된 클래스 계층 모듈."@ko .

pcpo:PropertiesModule
    a rdfs:Resource ;
    rdfs:label "속성 모듈"@ko , "Properties module"@en ;
    rdfs:comment "ontology/properties.ttl에 정의된 객체 연결 및 리터럴 속성 모듈."@ko .

pcpo:CodeListsModule
    a rdfs:Resource ;
    rdfs:label "코드 목록 모듈"@ko , "Code lists module"@en ;
    rdfs:comment "ontology/code-lists.ttl에 정의된 단위와 계산규칙 기준정보 모듈."@ko .
