@prefix pcpo: <https://example.org/pcpo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Documents
#################################################################

pcpo:Document a rdfs:Class ;
    rdfs:label "문서"@ko , "Document"@en ;
    rdfs:comment "계약 또는 기성 산정 과정에서 독립적으로 관리되는 문서나 시트."@ko .

pcpo:ContractDocument a rdfs:Class ;
    rdfs:subClassOf pcpo:Document ;
    rdfs:label "계약문서"@ko , "Contract Document"@en ;
    rdfs:comment "계약수량과 계약단가의 근거가 되는 문서."@ko .

pcpo:ContractBOQ a rdfs:Class ;
    rdfs:subClassOf pcpo:ContractDocument ;
    rdfs:label "최초 계약내역서"@ko , "Initial Contract BOQ"@en ;
    rdfs:comment "최초 계약버전의 공사항목과 계약조건을 기록한 내역서."@ko .

pcpo:RevisedContractBOQ a rdfs:Class ;
    rdfs:subClassOf pcpo:ContractDocument ;
    rdfs:label "변경 계약내역서"@ko , "Revised Contract BOQ"@en ;
    rdfs:comment "변경 계약버전에 따라 수정된 공사항목과 계약조건을 기록한 내역서."@ko .

pcpo:QuantityDocument a rdfs:Class ;
    rdfs:subClassOf pcpo:Document ;
    rdfs:label "수량문서"@ko , "Quantity Document"@en ;
    rdfs:comment "금회기성수량의 산출 근거를 기록하는 문서."@ko .

pcpo:CurrentProgressQTO a rdfs:Class ;
    rdfs:subClassOf pcpo:QuantityDocument ;
    rdfs:label "금회 기성수량산출서"@ko , "Current Progress Quantity Takeoff"@en ;
    rdfs:comment "특정 기성차수에 청구하는 금회기성수량과 위치 및 산출식을 제공하는 문서."@ko .

pcpo:PreviousApprovedProgressStatement a rdfs:Class ;
    rdfs:subClassOf pcpo:Document ;
    rdfs:label "전회 승인 공사기성부분내역서"@ko , "Previous Approved Progress Statement"@en ;
    rdfs:comment "금회 작성에 이월되는 전회 승인 누계수량과 누계금액의 근거 문서."@ko .

pcpo:CurrentProgressStatement a rdfs:Class ;
    rdfs:subClassOf pcpo:Document ;
    rdfs:label "금회 공사기성부분내역서"@ko , "Current Progress Statement"@en ;
    rdfs:comment "유효 계약조건과 금회수량 및 전회 승인값을 결합하여 금회와 누계 금액을 기록한 문서."@ko .

pcpo:WorkSummaryDocument a rdfs:Class ;
    rdfs:subClassOf pcpo:Document ;
    rdfs:label "공종별 집계표"@ko , "Work Summary Document"@en ;
    rdfs:comment "세부 기성항목의 금액을 공종별로 합산한 파생 결과 문서."@ko .

#################################################################
# Document lines
#################################################################

pcpo:DocumentLine a rdfs:Class ;
    rdfs:label "문서항목"@ko , "Document Line"@en ;
    rdfs:comment "문서에 실제로 기록된 행 또는 항목이며 현실의 계약공사항목과 구분된다."@ko .

pcpo:ContractDocumentLine a rdfs:Class ;
    rdfs:subClassOf pcpo:DocumentLine ;
    rdfs:label "계약문서항목"@ko , "Contract Document Line"@en ;
    rdfs:comment "계약내역서에서 특정 계약공사항목을 표현하는 행."@ko .

pcpo:QuantityCalculation a rdfs:Class ;
    rdfs:label "수량산출"@ko , "Quantity Calculation"@en ;
    rdfs:comment "금회기성수량을 도출하거나 원문 산출식을 보존하는 계산 개념."@ko .

pcpo:QuantityCalculationLine a rdfs:Class ;
    rdfs:subClassOf pcpo:DocumentLine , pcpo:QuantityCalculation ;
    rdfs:label "수량산출항목"@ko , "Quantity Calculation Line"@en ;
    rdfs:comment "금회 기성수량산출서의 위치, 부재, 산출식과 최종 수량을 기록하는 항목."@ko .

pcpo:PreviousProgressLine a rdfs:Class ;
    rdfs:subClassOf pcpo:DocumentLine ;
    rdfs:label "전회 승인 기성항목"@ko , "Previous Approved Progress Line"@en ;
    rdfs:comment "전회 승인 내역서에 기록된 누계수량과 누계금액 항목."@ko .

pcpo:ProgressClaimItem a rdfs:Class ;
    rdfs:label "기성청구항목"@ko , "Progress Claim Item"@en ;
    rdfs:comment "특정 기성차수에 계약공사항목을 기준으로 작성되는 기성 항목."@ko .

pcpo:CurrentProgressLine a rdfs:Class ;
    rdfs:subClassOf pcpo:DocumentLine , pcpo:ProgressClaimItem ;
    rdfs:label "금회 기성항목"@ko , "Current Progress Line"@en ;
    rdfs:comment "전회 승인값, 금회수량과 유효 계약단가를 결합한 금회 기성내역 항목."@ko .

#################################################################
# Project, contract, and progress concepts
#################################################################

pcpo:ConstructionProject a rdfs:Class ;
    rdfs:label "건설프로젝트"@ko , "Construction Project"@en ;
    rdfs:comment "기성 산정의 대상이 되는 공공 건설공사."@ko .

pcpo:Contract a rdfs:Class ;
    rdfs:label "계약"@ko , "Contract"@en ;
    rdfs:comment "프로젝트와 시공사 사이의 공사 계약."@ko .

pcpo:ContractVersion a rdfs:Class ;
    rdfs:label "계약버전"@ko , "Contract Version"@en ;
    rdfs:comment "적용기간이 명시된 최초 또는 변경 계약 상태."@ko .

pcpo:InitialContractVersion a rdfs:Class ;
    rdfs:subClassOf pcpo:ContractVersion ;
    rdfs:label "최초 계약버전"@ko , "Initial Contract Version"@en ;
    rdfs:comment "변경 전 최초로 체결된 계약버전."@ko .

pcpo:RevisedContractVersion a rdfs:Class ;
    rdfs:subClassOf pcpo:ContractVersion ;
    rdfs:label "변경 계약버전"@ko , "Revised Contract Version"@en ;
    rdfs:comment "선행 계약버전을 대체하는 변경 계약버전."@ko .

pcpo:ContractItem a rdfs:Class ;
    rdfs:label "계약공사항목"@ko , "Contract Item"@en ;
    rdfs:comment "특정 계약버전에서 수량, 단가, 단위와 항목코드가 정의되는 현실의 계약공사항목."@ko .

pcpo:ProgressClaim a rdfs:Class ;
    rdfs:label "기성청구"@ko , "Progress Claim"@en ;
    rdfs:comment "특정 기성차수에 제출하거나 승인하는 기성 청구 묶음."@ko .

pcpo:ProgressPeriod a rdfs:Class ;
    rdfs:label "기성차수"@ko , "Progress Period"@en ;
    rdfs:comment "기성 회차 번호와 기준일을 갖는 기간 식별자."@ko .

pcpo:ProgressSummary a rdfs:Class ;
    rdfs:subClassOf pcpo:DocumentLine ;
    rdfs:label "기성금액 집계"@ko , "Progress Amount Summary"@en ;
    rdfs:comment "세부 기성항목 또는 하위 공종 집계를 합산한 파생 금액."@ko .

pcpo:CalculationRule a rdfs:Class ;
    rdfs:label "계산규칙"@ko , "Calculation Rule"@en ;
    rdfs:comment "파생 수량과 금액의 계산식, 허용오차 및 반올림 기준을 설명하는 규칙."@ko .

#################################################################
# Work-item hierarchy
#################################################################

pcpo:ConstructionWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ContractItem ;
    rdfs:label "공사항목"@ko , "Construction Work Item"@en ;
    rdfs:comment "계약에서 수량과 단가가 부여되는 공사 작업 항목."@ko .

pcpo:ReinforcedConcreteWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ConstructionWorkItem ;
    rdfs:label "철근콘크리트공사항목"@ko , "Reinforced Concrete Work Item"@en ;
    rdfs:comment "철근, 콘크리트, 거푸집 또는 동바리공사에 속하는 계약공사항목의 상위 클래스."@ko .

pcpo:RebarWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ReinforcedConcreteWorkItem ;
    rdfs:label "철근공사항목"@ko , "Rebar Work Item"@en ;
    rdfs:comment "철근 가공, 조립 및 설치와 관련된 계약공사항목."@ko .

pcpo:ConcreteWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ReinforcedConcreteWorkItem ;
    rdfs:label "콘크리트공사항목"@ko , "Concrete Work Item"@en ;
    rdfs:comment "콘크리트 타설과 관련된 계약공사항목."@ko .

pcpo:FormworkWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ReinforcedConcreteWorkItem ;
    rdfs:label "거푸집공사항목"@ko , "Formwork Work Item"@en ;
    rdfs:comment "거푸집 설치와 해체에 관련된 계약공사항목."@ko .

pcpo:ShoringWorkItem a rdfs:Class ;
    rdfs:subClassOf pcpo:ReinforcedConcreteWorkItem ;
    rdfs:label "동바리공사항목"@ko , "Shoring Work Item"@en ;
    rdfs:comment "동바리 설치와 해체에 관련된 계약공사항목."@ko .

#################################################################
# Supporting concepts
#################################################################

pcpo:Unit a rdfs:Class ;
    rdfs:label "단위"@ko , "Unit"@en ;
    rdfs:comment "수량값의 측정 기준을 명시하는 코드 자원."@ko .

pcpo:Specification a rdfs:Class ;
    rdfs:label "규격"@ko , "Specification"@en ;
    rdfs:comment "품명과 분리하여 관리하는 계약공사항목의 규격 정보."@ko .

pcpo:ConstructionLocation a rdfs:Class ;
    rdfs:label "시공위치"@ko , "Construction Location"@en ;
    rdfs:comment "금회기성수량이 발생한 공사 위치."@ko .

pcpo:StructuralMember a rdfs:Class ;
    rdfs:label "구조부재"@ko , "Structural Member"@en ;
    rdfs:comment "수량산출 대상이 되는 기초, 기둥, 벽, 보 또는 슬래브 등의 부재."@ko .
