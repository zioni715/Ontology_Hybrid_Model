@prefix rcpp: <https://w3id.org/rcpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/rcpp>
    a rdfs:Resource ;
    dcterms:title "철근콘크리트공종 기성비용 산정서류 RDF/RDFS 온톨로지"@ko ;
    dcterms:identifier "RCPP" ;
    dcterms:hasVersion "0.9.0" ;
    dcterms:description "기성제출서류패키지, 문서, 문서섹션, 문서행, 업무항목, 항목규격, 공종 개념, 수량산출항목, 단가항목, 집계항목, 원가항목을 분리하고 계약-수량-단가-기성-집계-원가 계산 계보, 계산규칙, 통화, 비율, 단위 정보를 표현하는 RDF/RDFS 어휘."@ko ;
    rdfs:comment "문서 종류 축과 공종 축을 분리한다. 공종은 rdfs:Class가 아니라 WorkType의 개념 인스턴스로 두며, 문서에 실제로 나타난 원문값은 문서행에, 정규화된 업무 의미와 규격은 업무항목과 규격 노드에 둔다."@ko .

#################################################################
# 1. 상위 클래스
#################################################################

rcpp:DocumentPackage
    a rdfs:Class ;
    rdfs:label "문서 패키지"@ko ;
    rdfs:comment "기성 청구 또는 비용 산정을 위해 함께 제출·검토되는 문서 묶음."@ko .

rcpp:Document
    a rdfs:Class ;
    rdfs:label "문서"@ko ;
    rdfs:comment "독립 파일, 시트, 서식 또는 문서 단위. 공종은 문서 클래스의 하위분류가 아니라 관계로 연결한다."@ko .

rcpp:DocumentSection
    a rdfs:Class ;
    rdfs:label "문서 섹션"@ko ;
    rdfs:comment "문서 안에서 특정 공종, 표, 집계, 산출 범위를 담당하는 구획."@ko .

rcpp:WorkType
    a rdfs:Class ;
    rdfs:label "공종"@ko ;
    rdfs:comment "비용산정 대상이 되는 공종 또는 하위 공종의 개념 인스턴스 유형. 예: 철근공사, 콘크리트공사."@ko .

rcpp:BusinessItem
    a rdfs:Class ;
    rdfs:label "업무항목"@ko ;
    rdfs:comment "여러 문서행이 함께 가리키는 업무상 동일 비용산정 항목. 정규화된 항목명, 표준 단위코드, 공종, 구조화된 규격을 갖고 문서 위치와 원문값은 문서행에 둔다."@ko .

rcpp:ItemSpecification
    a rdfs:Class ;
    rdfs:label "항목 규격"@ko ;
    rdfs:comment "업무항목의 규격을 문서 원문과 구조화 속성으로 표현하는 노드. 같은 업무명이라도 규격이 다르면 별도 업무항목과 규격 노드로 분리한다."@ko .

rcpp:RebarSpecification
    a rdfs:Class ;
    rdfs:label "철근 규격"@ko ;
    rdfs:subClassOf rcpp:ItemSpecification .

rcpp:ConcreteSpecification
    a rdfs:Class ;
    rdfs:label "콘크리트 규격"@ko ;
    rdfs:subClassOf rcpp:ItemSpecification .

rcpp:FormworkSpecification
    a rdfs:Class ;
    rdfs:label "거푸집 규격"@ko ;
    rdfs:subClassOf rcpp:ItemSpecification .

rcpp:ShoringSpecification
    a rdfs:Class ;
    rdfs:label "동바리 규격"@ko ;
    rdfs:subClassOf rcpp:ItemSpecification .

rcpp:DocumentRow
    a rdfs:Class ;
    rdfs:label "문서행"@ko ;
    rdfs:subClassOf rcpp:LineItem ;
    rdfs:comment "특정 문서 또는 시트에 실제로 나타난 행 단위 기록. 동일 업무항목이라도 문서별 행은 별도 인스턴스로 식별한다."@ko .

rcpp:LineItem
    a rdfs:Class ;
    rdfs:label "항목"@ko ;
    rdfs:comment "계약, 기성, 수량산출, 단가, 집계 문서에서 행 단위로 관리되는 정보."@ko .

rcpp:CostItem
    a rdfs:Class ;
    rdfs:label "원가항목"@ko ;
    rdfs:comment "원가계산서에서 직접공사비, 간접공사비, 법정경비, 일반관리비, 이윤, 부가가치세처럼 구분되는 비용 구성항목."@ko .

rcpp:AggregateValue
    a rdfs:Class ;
    rdfs:label "집계값"@ko ;
    rdfs:comment "공급가액, 부가가치세액, 총공사비처럼 여러 항목을 계산하여 얻는 값."@ko .

rcpp:StandardReference
    a rdfs:Class ;
    rdfs:label "표준원가근거"@ko ;
    rdfs:comment "표준품셈, 표준시장단가 등 단가 또는 소요량 산정에 사용하는 공식 기준."@ko .

#################################################################
# 2. 문서 패키지와 문서 유형
#################################################################

rcpp:ProgressPaymentSubmissionPackage
    a rdfs:Class ;
    rdfs:label "기성제출서류패키지"@ko ;
    rdfs:subClassOf rcpp:DocumentPackage ;
    rdfs:comment "공사기성부분내역서와 그 산정 근거가 되는 문서들을 함께 묶은 제출 단위."@ko .

rcpp:RcppProgressPaymentSubmissionPackage
    a rdfs:Class ;
    rdfs:label "철근콘크리트공종 기성제출서류패키지"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentSubmissionPackage ;
    rdfs:comment "aboutWorkType이 철근콘크리트공사인 기성제출서류패키지. RDFS에서는 OWL 정의 클래스가 아니므로 인스턴스의 aboutWorkType 값과 사용 규칙으로 관리한다."@ko .

rcpp:ProgressPaymentDocument
    a rdfs:Class ;
    rdfs:label "기성서류"@ko ;
    rdfs:subClassOf rcpp:Document .

rcpp:StatementDocument
    a rdfs:Class ;
    rdfs:label "내역서"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "공사비 또는 기성비용을 항목, 수량, 단가, 금액, 비율로 표시하는 문서 유형."@ko .

rcpp:ProgressPaymentStatement
    a rdfs:Class ;
    rdfs:label "공사기성부분내역서"@ko ;
    rdfs:subClassOf rcpp:StatementDocument ;
    rdfs:comment "도급액, 공사명, 기성부분금액과 기성내역행을 최종 표시하는 문서."@ko .

rcpp:ContractBOQ
    a rdfs:Class ;
    rdfs:label "계약 산출내역서"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "계약 기준 항목, 규격, 단위, 계약수량, 계약단가, 계약금액을 제공하는 문서."@ko .

rcpp:TradeDetailSheet
    a rdfs:Class ;
    rdfs:label "공종별내역서"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "공종별 기성 내역항목의 계약·전회·금회·누계·잔여 수량 및 금액을 관리하는 문서."@ko .

rcpp:TradeSummarySheet
    a rdfs:Class ;
    rdfs:label "공종별집계표"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "공종별내역서의 하위 내역항목을 공종 기준으로 집계하는 문서."@ko .

rcpp:QuantityTakeoffSheet
    a rdfs:Class ;
    rdfs:label "수량산출서"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "위치, 부재, 치수, 산식, 공제·할증 조건으로 기성수량을 산출하는 문서."@ko .

rcpp:UnitPriceBasisDocument
    a rdfs:Class ;
    rdfs:label "단가근거서류"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "일위대가, 단가산출, 자재단가, 표준 기준 등 적용단가의 근거를 제공하는 문서군."@ko .

rcpp:UnitPriceBasisPackage
    a rdfs:Class ;
    rdfs:label "단가근거서류패키지"@ko ;
    rdfs:subClassOf rcpp:DocumentPackage ;
    rdfs:comment "단가산출서, 일위대가표, 소요자재단가현황 등 단가 근거 문서들을 묶은 하위 패키지."@ko .

rcpp:UnitPriceTable
    a rdfs:Class ;
    rdfs:label "일위대가표"@ko ;
    rdfs:subClassOf rcpp:UnitPriceBasisDocument .

rcpp:UnitPriceCalculationSheet
    a rdfs:Class ;
    rdfs:label "단가산출서"@ko ;
    rdfs:subClassOf rcpp:UnitPriceBasisDocument .

rcpp:MaterialPriceSurvey
    a rdfs:Class ;
    rdfs:label "소요자재단가현황"@ko ;
    rdfs:subClassOf rcpp:UnitPriceBasisDocument .

rcpp:CostCalculationSheet
    a rdfs:Class ;
    rdfs:label "원가계산서"@ko ;
    rdfs:subClassOf rcpp:ProgressPaymentDocument ;
    rdfs:comment "직접공사비, 간접공사비, 법정경비, 일반관리비, 이윤, 부가가치세 등 원가항목을 계산하는 문서."@ko .

#################################################################
# 3. 공종 축
#################################################################

rcpp:ReinforcedConcreteWork
    a rcpp:WorkType ;
    rdfs:label "철근콘크리트공사"@ko ;
    rdfs:comment "공사기성부분내역서에서 비용 산정 대상이 되는 철근콘크리트공종 개념. 하위 공종은 각 하위 공종의 isSubWorkTypeOf 관계로 찾는다."@ko .

rcpp:RebarWork
    a rcpp:WorkType ;
    rdfs:label "철근공사"@ko ;
    rdfs:comment "가공, 조립, 이음, 정착 등은 기본적으로 aboutWorkType과 수량산출항목의 조건 속성으로 기록하고, 강종·호칭·공칭직경은 철근 규격 노드에서 관리한다."@ko ;
    rcpp:isSubWorkTypeOf rcpp:ReinforcedConcreteWork .

rcpp:ConcreteWork
    a rcpp:WorkType ;
    rdfs:label "콘크리트공사"@ko ;
    rdfs:comment "콘크리트 종류, 설계기준강도, 골재치수, 슬럼프 같은 규격값은 콘크리트 규격 노드에서 관리하고 부재치수, 공제·할증 등 산출 조건은 수량산출항목에 둔다."@ko ;
    rcpp:isSubWorkTypeOf rcpp:ReinforcedConcreteWork .

rcpp:Formwork
    a rcpp:WorkType ;
    rdfs:label "거푸집공사"@ko ;
    rdfs:comment "재료·형식, 적용부재 같은 규격값은 거푸집 규격 노드에서 관리하고 접촉면 치수, 면수, 개소수, 공제면적 등 산출 조건은 수량산출항목에 둔다."@ko ;
    rcpp:isSubWorkTypeOf rcpp:ReinforcedConcreteWork .

rcpp:ShoringWork
    a rcpp:WorkType ;
    rdfs:label "동바리공사"@ko ;
    rdfs:comment "동바리 시스템과 적용높이 같은 규격값은 동바리 규격 노드에서 관리하고 지지부재, 측정방식, 평면치수, 간격, 임대기간 등 산출 조건은 수량산출항목에 둔다."@ko ;
    rcpp:isSubWorkTypeOf rcpp:ReinforcedConcreteWork .

#################################################################
# 4. 문서 섹션과 행 단위 항목
#################################################################

rcpp:ProgressPaymentSection
    a rdfs:Class ;
    rdfs:label "기성내역섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:ContractBOQSection
    a rdfs:Class ;
    rdfs:label "계약내역섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:TradeDetailSection
    a rdfs:Class ;
    rdfs:label "공종내역섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection ;
    rdfs:comment "공종별내역서 내부에서 특정 공종의 내역항목을 담는 섹션. aboutWorkType으로 공종을 참조한다."@ko .

rcpp:TradeSummarySection
    a rdfs:Class ;
    rdfs:label "공종집계섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:QuantityTakeoffSection
    a rdfs:Class ;
    rdfs:label "수량산출섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:UnitPriceBasisSection
    a rdfs:Class ;
    rdfs:label "단가근거섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:CostCalculationSection
    a rdfs:Class ;
    rdfs:label "원가계산섹션"@ko ;
    rdfs:subClassOf rcpp:DocumentSection .

rcpp:ProgressLineItem
    a rdfs:Class ;
    rdfs:label "기성내역항목"@ko ;
    rdfs:subClassOf rcpp:LineItem ;
    rdfs:comment "공사기성부분내역서 또는 공종별내역서의 행 단위 비용 항목. 계약·수량·단가·집계 항목과 연결된다."@ko .

rcpp:ProgressStatementLineItem
    a rdfs:Class ;
    rdfs:label "공사기성부분내역서 행"@ko ;
    rdfs:subClassOf rcpp:DocumentRow ,
        rcpp:ProgressLineItem ;
    rdfs:comment "공사기성부분내역서에 실제로 기재된 기성 내역 행. 공종별내역서 행과 값이 같아도 별도 인스턴스로 식별한다."@ko .

rcpp:TradeDetailLineItem
    a rdfs:Class ;
    rdfs:label "공종별내역서 행"@ko ;
    rdfs:subClassOf rcpp:DocumentRow ,
        rcpp:ProgressLineItem ;
    rdfs:comment "공종별내역서에 실제로 기재된 공종별 내역 행. 공사기성부분내역서 행의 근거 또는 원천 행이 될 수 있다."@ko .

rcpp:ContractBOQLineItem
    a rdfs:Class ;
    rdfs:label "계약산출내역서 행"@ko ;
    rdfs:subClassOf rcpp:DocumentRow ,
        rcpp:ContractLineItem ;
    rdfs:comment "계약 산출내역서에 실제로 기재된 계약 기준 행."@ko .

rcpp:ContractLineItem
    a rdfs:Class ;
    rdfs:label "계약내역항목"@ko ;
    rdfs:subClassOf rcpp:LineItem .

rcpp:QuantityCalculationItem
    a rdfs:Class ;
    rdfs:label "수량산출항목"@ko ;
    rdfs:subClassOf rcpp:LineItem .

rcpp:UnitPriceItem
    a rdfs:Class ;
    rdfs:label "단가항목"@ko ;
    rdfs:subClassOf rcpp:LineItem .

rcpp:UnitPriceCompositionItem
    a rdfs:Class ;
    rdfs:label "일위대가항목"@ko ;
    rdfs:subClassOf rcpp:UnitPriceItem .

rcpp:MaterialPriceItem
    a rdfs:Class ;
    rdfs:label "자재단가항목"@ko ;
    rdfs:subClassOf rcpp:UnitPriceItem .

rcpp:SummaryLineItem
    a rdfs:Class ;
    rdfs:label "집계항목"@ko ;
    rdfs:subClassOf rcpp:LineItem .

rcpp:CalculationRule
    a rdfs:Class ;
    rdfs:label "계산규칙"@ko ;
    rdfs:comment "계산 대상 값이 어떤 입력값과 연산자로 산출되는지 기계 판독 가능하게 표현하는 규칙."@ko .

rcpp:SumCalculation
    a rdfs:Class ;
    rdfs:label "합산계산"@ko ;
    rdfs:subClassOf rcpp:CalculationRule .

rcpp:RateCalculation
    a rdfs:Class ;
    rdfs:label "요율계산"@ko ;
    rdfs:subClassOf rcpp:CalculationRule .

#################################################################
# 5. 원가항목과 표준근거
#################################################################

rcpp:DirectConstructionCost
    a rdfs:Class ;
    rdfs:label "직접공사비"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:IndirectConstructionCost
    a rdfs:Class ;
    rdfs:label "간접공사비"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:StatutoryExpense
    a rdfs:Class ;
    rdfs:label "법정경비"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:GeneralAdministrationCost
    a rdfs:Class ;
    rdfs:label "일반관리비"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:Profit
    a rdfs:Class ;
    rdfs:label "이윤"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:ValueAddedTax
    a rdfs:Class ;
    rdfs:label "부가가치세"@ko ;
    rdfs:subClassOf rcpp:CostItem .

rcpp:SubtotalAmount
    a rdfs:Class ;
    rdfs:label "공급가액"@ko ;
    rdfs:subClassOf rcpp:AggregateValue .

rcpp:TotalAmount
    a rdfs:Class ;
    rdfs:label "총공사비"@ko ;
    rdfs:subClassOf rcpp:AggregateValue .

rcpp:StandardProductionRate
    a rdfs:Class ;
    rdfs:label "표준품셈"@ko ;
    rdfs:subClassOf rcpp:StandardReference .

rcpp:StandardMarketRate
    a rdfs:Class ;
    rdfs:label "표준시장단가"@ko ;
    rdfs:subClassOf rcpp:StandardReference .

#################################################################
# 6. 객체속성
#################################################################

rcpp:hasDocument a rdf:Property ; rdfs:label "hasDocument" ; rdfs:domain rcpp:DocumentPackage ; rdfs:range rcpp:Document .
rcpp:hasSheet a rdf:Property ; rdfs:label "hasSheet" ; rdfs:comment "하나의 파일 안에서 시트를 문서 단위로 다룰 때 사용한다."@ko .
rcpp:hasSection a rdf:Property ; rdfs:label "hasSection" ; rdfs:range rcpp:DocumentSection .
rcpp:hasPart a rdf:Property ; rdfs:label "hasPart" .
rcpp:aboutWorkType a rdf:Property ; rdfs:label "aboutWorkType" ; rdfs:range rcpp:WorkType .
rcpp:isSubWorkTypeOf a rdf:Property ; rdfs:label "isSubWorkTypeOf" ; rdfs:domain rcpp:WorkType ; rdfs:range rcpp:WorkType .
rcpp:hasLineItem a rdf:Property ; rdfs:label "hasLineItem" ; rdfs:domain rcpp:DocumentSection ; rdfs:range rcpp:LineItem .
rcpp:describesBusinessItem a rdf:Property ; rdfs:label "describesBusinessItem" ; rdfs:domain rcpp:DocumentRow ; rdfs:range rcpp:BusinessItem .
