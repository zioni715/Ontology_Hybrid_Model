        rcpp:예시_동바리단가근거섹션 .

rcpp:예시_일위대가표
    a rcpp:UnitPriceTable ;
    rdfs:label "예시 일위대가표"@ko ;
    rcpp:documentName "일위대가표" .

rcpp:예시_소요자재단가현황
    a rcpp:MaterialPriceSurvey ;
    rdfs:label "예시 소요자재단가현황"@ko ;
    rcpp:documentName "소요자재단가현황" .

rcpp:예시_원가계산서
    a rcpp:CostCalculationSheet ;
