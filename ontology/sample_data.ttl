rcpp:예시_직접공사비
    a rcpp:DirectConstructionCost ;
    rdfs:label "예시 직접공사비"@ko ;
    rcpp:amountValue "11360000"^^xsd:decimal ;
    rcpp:calculationFormula "직접공사비 = 철근공사 집계금액 + 콘크리트공사 집계금액 + 거푸집공사 집계금액 + 동바리공사 집계금액" ;
    rcpp:computedBy rcpp:예시_직접공사비계산 ;
    rcpp:isCalculatedFrom
        rcpp:예시_집계항목_철근 ,
        rcpp:예시_집계항목_콘크리트 ,
        rcpp:예시_집계항목_거푸집 ,
        rcpp:예시_집계항목_동바리 .

rcpp:예시_간접공사비
    a rcpp:IndirectConstructionCost ;
    rdfs:label "예시 간접공사비"@ko ;
    rcpp:amountValue "1136000"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_간접공사비계산 ;
    rcpp:isCalculatedFrom rcpp:예시_직접공사비 ;
    rcpp:calculationFormula "간접공사비 = 직접공사비 × 0.10" .

rcpp:예시_법정경비
    a rcpp:StatutoryExpense ;
    rdfs:label "예시 법정경비"@ko ;
    rcpp:amountValue "227200"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_법정경비계산 ;
    rcpp:isCalculatedFrom rcpp:예시_직접공사비 ;
    rcpp:calculationFormula "법정경비 = 직접공사비 × 0.02" .

rcpp:예시_일반관리비
    a rcpp:GeneralAdministrationCost ;
    rdfs:label "예시 일반관리비"@ko ;
    rcpp:amountValue "636160"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_일반관리비계산 ;
    rcpp:isCalculatedFrom
        rcpp:예시_직접공사비 ,
        rcpp:예시_간접공사비 ,
        rcpp:예시_법정경비 ;
    rcpp:calculationFormula "일반관리비 = (직접공사비 + 간접공사비 + 법정경비) × 0.05" .

rcpp:예시_이윤
    a rcpp:Profit ;
    rdfs:label "예시 이윤"@ko ;
    rcpp:amountValue "1335936"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_이윤계산 ;
    rcpp:isCalculatedFrom
        rcpp:예시_직접공사비 ,
        rcpp:예시_간접공사비 ,
        rcpp:예시_법정경비 ,
        rcpp:예시_일반관리비 ;
    rcpp:calculationFormula "이윤 = (직접공사비 + 간접공사비 + 법정경비 + 일반관리비) × 0.10" .

rcpp:예시_공급가액
    a rcpp:SubtotalAmount ;
    rdfs:label "예시 공급가액"@ko ;
    rcpp:amountValue "14695296"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_공급가액계산 ;
    rcpp:isCalculatedFrom
        rcpp:예시_직접공사비 ,
        rcpp:예시_간접공사비 ,
        rcpp:예시_법정경비 ,
        rcpp:예시_일반관리비 ,
        rcpp:예시_이윤 ;
    rcpp:calculationFormula "공급가액 = 직접공사비 + 간접공사비 + 법정경비 + 일반관리비 + 이윤" .

rcpp:예시_부가가치세
    a rcpp:ValueAddedTax ;
    rdfs:label "예시 부가가치세"@ko ;
    rcpp:amountValue "1469529.6"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_부가가치세계산 ;
    rcpp:isCalculatedFrom rcpp:예시_공급가액 ;
    rcpp:calculationFormula "부가가치세 = 공급가액 × 0.10" .

rcpp:예시_총공사비
    a rcpp:TotalAmount ;
    rdfs:label "예시 총공사비"@ko ;
    rcpp:amountValue "16164825.6"^^xsd:decimal ;
    rcpp:computedBy rcpp:예시_총공사비계산 ;
    rcpp:isCalculatedFrom
        rcpp:예시_공급가액 ,
        rcpp:예시_부가가치세 ;
    rcpp:calculationFormula "총공사비 = 공급가액 + 부가가치세" .

