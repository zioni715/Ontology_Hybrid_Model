@prefix rcpp: <https://w3id.org/rcpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# RDF 인스턴스 예시
#
# 공종은 WorkType 개념 인스턴스로 공유한다.
# 업무상 동일 항목과 문서에 실제로 나타난 행은 분리한다.
#################################################################

rcpp:예시_기성제출서류패키지
    a rcpp:RcppProgressPaymentSubmissionPackage ;
    rdfs:label "예시 철근콘크리트공종 기성제출서류패키지"@ko ;
    rcpp:projectName "예시 공사" ;
    rcpp:progressRound 1 ;
    rcpp:currencyCode "KRW" ;
    rcpp:amountScale "1"^^xsd:decimal ;
    rcpp:hasPart rcpp:예시_단가근거서류패키지 ;
    rcpp:hasDocument
        rcpp:예시_공사기성부분내역서 ,
        rcpp:예시_계약산출내역서 ,
        rcpp:예시_공종별내역서 ,
        rcpp:예시_공종별집계표 ,
        rcpp:예시_수량산출서 ,
        rcpp:예시_원가계산서 .

#################################################################
# 문서
#################################################################

rcpp:예시_공사기성부분내역서
    a rcpp:ProgressPaymentStatement ;
    rdfs:label "예시 공사기성부분내역서"@ko ;
    rcpp:documentName "공사기성부분내역서" ;
    rcpp:hasSection rcpp:예시_기성내역섹션 ;
    rcpp:referencesContractDocument rcpp:예시_계약산출내역서 ;
    rcpp:supportedBy
        rcpp:예시_공종별내역서 ,
        rcpp:예시_공종별집계표 ,
        rcpp:예시_수량산출서 ,
        rcpp:예시_단가근거서류패키지 .

rcpp:예시_계약산출내역서
    a rcpp:ContractBOQ ;
