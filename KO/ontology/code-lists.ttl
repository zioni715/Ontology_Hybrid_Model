#################################################################
# Included and excluded scope
#################################################################

rcpp:IncludedDocumentTypes a rdfs:Resource ;
    rdfs:label "사용 기성서류"@ko ;
    rdfs:comment "산정 근거서류는 수량산출서·계약내역서·공종별내역서·공종별집계표·기성수량산출서·전회 공사기성부분내역서와 단가·원가 지원서류이고, 산정 결과서류는 공사기성부분내역서이다."@ko .
rcpp:IncludedWorkScope a rdfs:Resource ;
    rdfs:label "현재 포함 공종"@ko ;
    rdfs:comment "현재 온톨로지 구축 범위는 철근콘크리트공종 하나이며 세부공종은 철근·콘크리트·거푸집·동바리 네 가지로 한정한다. 다른 공종은 현재 클래스·속성 범위에 포함하지 않는다."@ko .
rcpp:ExcludedWorkScope a rdfs:Resource ;
    rdfs:label "제외 서류와 판단"@ko ;
    rdfs:comment "검측요청서·검측결과서, 작업일보·시공일보, 콘크리트 타설일보, 철근가공조서·배근 검측자료, 물량측정서, 시공사진, 자재납품서를 제외한다. 실제 시공 여부·검측 적합성·품질 적합성을 판정하지 않는다."@ko .

rcpp:AutomationGoal a rdfs:Resource ;
    rdfs:label "기성서류 작성 자동화 목표"@ko ;
    rdfs:comment "서류를 반복 탐색하는 비표준 업무를 서류내역 매핑 순서로 정리하여 재작업과 오류를 줄이고, 최종적으로 확장 가능한 기성서류 작성 자동화를 구현한다."@ko .
