    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ;
    rdfs:label "정규화 내역코드"@ko ; rdfs:comment "프로젝트별 원문 품목코드와 구분되는 표준 비용항목의 기준 식별자."@ko .
rcpp:costItemName a rdf:Property ; rdfs:domain rcpp:CostItem ; rdfs:range rdfs:Literal ;
    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ;
    rdfs:label "정규화 품명"@ko ; rdfs:comment "표준 공종·정규화 규격·표준 단위와 함께 동일 표준 비용항목을 판별하는 프로젝트 독립 품명."@ko .

#################################################################
# Price-identifying cost-item properties
# These values are held directly by each work-specific cost item and appear
# in the visualization side panel instead of being rendered as child nodes.
#################################################################

