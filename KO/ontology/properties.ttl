    rcpp:exampleValue "13 mm"@ko ;
    rdfs:label "최대지름(mm)"@ko ; rdfs:comment "단가가 적용되는 철근 지름구간의 최댓값."@ko .
rcpp:diameterCategory a rdf:Property ; rdfs:domain rcpp:RebarCostItem ; rdfs:range xsd:string ;
    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ; rcpp:specificationRequirement "조건부" ;
