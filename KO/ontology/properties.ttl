    rcpp:exampleValue "D10~D13"@ko ;
    rdfs:label "지름구간"@ko ; rdfs:comment "단가가 적용되는 철근 지름 범위."@ko .
rcpp:rebarWorkType a rdf:Property ; rdfs:domain rcpp:RebarCostItem ; rdfs:range rcpp:RebarWorkType ;
    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ; rcpp:specificationRequirement "우선 포함" ;
    rcpp:exampleValue "가공"@ko , "조립"@ko , "가공 및 조립"@ko ;
    rdfs:label "철근 작업유형"@ko ; rdfs:comment "철근에 수행되는 비용산정 작업."@ko .
