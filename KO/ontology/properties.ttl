    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 2 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rcpp:matchesWithField rcpp:contractWorkType ;
