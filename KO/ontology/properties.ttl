    rdfs:subPropertyOf rcpp:hasAmountValue ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ;
    rcpp:fieldOrder 26 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaExpression "공종별 계약금액 = Σ(공종 내 상세항목 계약금액)"@ko ; rdfs:label "공종별 계약금액"@ko ;
    rdfs:comment "동일 공종에 속한 기성 상세내역의 계약금액을 합산한 공종별 계약금액 집계값."@ko .
rcpp:outputSummaryPreviousAmount a rdf:Property ; rdfs:domain rcpp:CurrentProgressSummaryItem ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf rcpp:hasAmountValue ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ;
    rcpp:fieldOrder 27 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaExpression "공종별 전회누계기성금액 = Σ(공종 내 상세항목 전회누계기성금액)"@ko ; rdfs:label "공종별 전회누계기성금액"@ko ;
    rdfs:comment "동일 공종에 속한 기성 상세내역의 전회누계기성금액을 합산한 공종별 이월 금액 집계값."@ko .
rcpp:outputSummaryCurrentAmount a rdf:Property ; rdfs:domain rcpp:CurrentProgressSummaryItem ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf rcpp:hasAmountValue ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ;
    rcpp:fieldOrder 28 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaExpression "공종별 금회기성금액 = Σ(공종 내 상세항목 금회기성금액)"@ko ; rdfs:label "공종별 금회기성금액"@ko ;
    rdfs:comment "동일 공종에 속한 기성 상세내역의 금회기성금액을 합산한 공종별 현재 회차 금액 집계값."@ko .
rcpp:outputSummaryCumulativeAmount a rdf:Property ; rdfs:domain rcpp:CurrentProgressSummaryItem ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf rcpp:hasAmountValue ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ;
    rcpp:fieldOrder 29 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaExpression "공종별 누계기성금액 = 공종별 전회누계기성금액 + 공종별 금회기성금액"@ko ; rdfs:label "공종별 누계기성금액"@ko ;
    rdfs:comment "공종별 전회누계기성금액과 금회기성금액을 합산한 현재 회차까지의 공종별 누계 금액 집계값."@ko .

rcpp:outputContractAmount rcpp:aggregatesTo rcpp:outputSummaryContractAmount .
rcpp:outputWorkType rcpp:groupsByField rcpp:outputSummaryWorkCategoryText .
