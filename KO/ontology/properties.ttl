rcpp:contractItemCode a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 1 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "식별" ;
    rcpp:mapsDirectlyTo rcpp:workDetailItemCode , rcpp:outputItemCode ;
    rdfs:label "계약 품목코드"@ko ; rdfs:comment "계약내역서·수량산출서·전회 공사기성부분내역서와 산정 결과서류의 동일 행을 연결하는 기본 매칭키."@ko .
rcpp:contractWorkType a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 2 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailWorkType , rcpp:outputWorkType ;
    rdfs:label "공종"@ko ; rdfs:comment "철근·콘크리트·거푸집·동바리 등 계약 공종."@ko .
rcpp:contractItemName a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 3 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailItemName , rcpp:outputWorkDescription ;
    rdfs:label "공사내역·세부품목"@ko ; rdfs:comment "최종 공사내역 열에 전달되는 계약 품목명."@ko .
rcpp:contractSpecification a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 4 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailSpecification , rcpp:outputSpecification ;
    rdfs:label "규격"@ko ; rdfs:comment "계약 품목의 원문 규격이며 품목코드와 함께 매칭 정확도를 높인다."@ko .
rcpp:contractUnit a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 5 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailUnit , rcpp:outputUnit ;
    rcpp:consistencyComparedWith rcpp:quantityUnit , rcpp:outputUnit ;
    rdfs:label "단위"@ko ; rdfs:comment "계약수량·금회기성수량·출력수량에 공통으로 적용되어야 하는 단위."@ko .
rcpp:contractQuantity a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 6 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailQuantity , rcpp:outputContractQuantity ; rcpp:calculationInputFor rcpp:contractAmount , rcpp:progressRemainingQuantity ;
    rcpp:consistencyComparedWith rcpp:outputCumulativeQuantity ;
    rdfs:label "계약수량"@ko ; rdfs:comment "계약금액과 잔여수량의 기준이 되는 계약 수량."@ko .
rcpp:contractUnitPrice a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 7 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "입력" ;
    rcpp:mapsDirectlyTo rcpp:workDetailUnitPrice , rcpp:outputContractUnitPrice ; rcpp:calculationInputFor rcpp:contractAmount ;
    rdfs:label "계약단가"@ko ; rdfs:comment "계약금액과 금회기성금액에 적용되는 계약 단가. 전회누계기성금액은 전회서류 값을 이월하고 이 단가로 계산한 값은 교차검토에만 사용한다."@ko .
rcpp:contractAmount a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 8 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "계산" ;
    rcpp:formulaCategory "기본" ; rcpp:formulaExpression "계약금액 = 계약수량 × 계약단가"@ko ;
    rcpp:mapsDirectlyTo rcpp:workDetailAmount , rcpp:outputContractAmount ; rcpp:consistencyComparedWith rcpp:outputContractAmount ;
    rdfs:label "계약금액"@ko ; rdfs:comment "계약수량과 계약단가의 곱이며 비율과 잔여금액의 기준 금액. 도급금액·도급액은 원문 필드명으로 보존한다."@ko .
rcpp:contractQuantityBasis a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:ContractStatement ; rcpp:fieldOrder 9 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rdfs:label "계약수량 산출근거"@ko ; rdfs:comment "수량산출서에서 전달된 계약수량의 구조물·위치·규격·산식 근거."@ko .

