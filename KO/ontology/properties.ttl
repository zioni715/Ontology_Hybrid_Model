rcpp:unitSymbol a rdf:Property ; rdfs:domain rcpp:Unit ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ; rdfs:label "단위 기호"@ko ;
    rdfs:comment "수량과 함께 표시하는 측정단위의 짧은 기호 또는 현장 표기."@ko .
rcpp:unitDimension a rdf:Property ; rdfs:domain rcpp:Unit ; rdfs:range rdfs:Literal ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ; rdfs:label "단위 차원"@ko ;
