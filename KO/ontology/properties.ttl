rcpp:supportSpecification a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 4 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rcpp:matchesWithField rcpp:contractSpecification ;
    rdfs:label "지원자료 규격"@ko ; rdfs:comment "계약 규격과 비교하는 지원자료 규격."@ko .
rcpp:supportUnit a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 5 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rcpp:matchesWithField rcpp:contractUnit ; rcpp:consistencyComparedWith rcpp:contractUnit ;
    rdfs:label "지원자료 단위"@ko ; rdfs:comment "계약 단위와 비교하는 지원자료 단위."@ko .
rcpp:supportQuantity a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 6 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rdfs:label "지원자료 수량"@ko ; rdfs:comment "품목 또는 집계의 교차확인에 사용하는 지원자료 수량."@ko .
rcpp:supportUnitPrice a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 7 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
    rcpp:consistencyComparedWith rcpp:contractUnitPrice ;
    rdfs:label "지원자료 단가"@ko ; rdfs:comment "계약단가 구성 또는 값을 교차확인하는 지원자료 단가."@ko .
rcpp:supportAmount a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 8 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "계산" ;
    rdfs:label "지원자료 금액·집계"@ko ; rdfs:comment "품목별·공종별·전체 금액을 교차확인하는 지원자료 금액."@ko .
