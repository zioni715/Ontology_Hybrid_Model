    rcpp:formulaCategory "기본" ; rcpp:formulaExpression "금회기성비율(%) = 금회기성금액 ÷ 계약금액 × 100"@ko ;
    rdfs:label "금회기성비율(%)"@ko ; rdfs:comment "금회기성금액의 계약금액 대비 비율."@ko .
