@prefix rcpp: <https://example.org/rcpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology and visualization metadata
#################################################################

rcpp:propertyCategory a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "속성 구분"@ko ; rdfs:comment "관계·식별·입력·계산·출력 속성을 구분한다."@ko .
rcpp:formulaExpression a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "산식"@ko ; rdfs:comment "클래스 또는 서류내역에 적용되는 계산식을 기록한다."@ko .
rcpp:crossCheckFormulaExpression a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "교차검토 산식"@ko ; rdfs:comment "원천 서류의 확정값을 대체하지 않고 계산 결과와 비교하는 검토용 산식을 기록한다."@ko .
rcpp:formulaCategory a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "산식 구분"@ko ; rdfs:comment "기본·공종별·집계·일관성 산식을 구분한다."@ko .
rcpp:appliesToClass a rdf:Property ; rdfs:range rdfs:Class ;
    rdfs:label "적용 클래스"@ko ; rdfs:comment "속성이 적용되는 하나 이상의 클래스를 명시한다."@ko .
rcpp:processStage a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "처리 단계"@ko ; rdfs:comment "기성서류 작성 흐름에서 담당하는 단계를 표시한다."@ko .
rcpp:outputColumnGroup a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "출력 열 그룹"@ko ; rdfs:comment "공사기성부분내역서에서 항목이 배치되는 열을 표시한다."@ko .
rcpp:namespaceUri a rdf:Property ; rdfs:range xsd:anyURI ;
    rdfs:label "네임스페이스 URI"@ko ;
    rdfs:comment "RCPP 자원 IRI의 공통 기반으로 사용하는 온톨로지 네임스페이스 주소."@ko .
rcpp:documentCode a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "문서코드"@ko ; rdfs:comment "서류 유형을 구분하는 온톨로지 문서코드."@ko .
rcpp:sourceFieldLabel a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "원문 필드명"@ko ; rdfs:comment "표준 온톨로지 개념에 대응하는 프로젝트 서류의 원래 열 이름이나 동의 표현."@ko .
rcpp:fieldOfDocument a rdf:Property ; rdfs:range rdfs:Class ;
    rdfs:label "소속 서류"@ko ; rdfs:comment "데이터 항목이 정의된 서류 유형."@ko .
rcpp:fieldOrder a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:label "내역 순서"@ko ; rdfs:comment "서류내역 흐름 시각화에서 사용하는 의미 순서."@ko .
rcpp:graphLevel a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "그래프 표시수준"@ko ; rdfs:comment "core·extended·structure·detail 중 시각화 노출 수준."@ko .
rcpp:visualizationGroup a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "시각화 그룹"@ko ; rdfs:comment "서류·처리·산출유형 등 화면 배치 그룹."@ko .
rcpp:requirementLevel a rdf:Property ; rdfs:domain rcpp:FieldRequirement ; rdfs:range rdfs:Literal ;
    rdfs:label "요구수준"@ko ; rdfs:comment "필수·조건부·권장 등 속성과 적용 클래스 조합의 요구수준."@ko .
rcpp:requirementPurpose a rdf:Property ; rdfs:domain rcpp:FieldRequirement ; rdfs:range xsd:string ;
    rdfs:label "요구 목적"@ko ; rdfs:comment "원천입력·이월입력·계산입력·계산결과·결과서류출력·교차검토 중 필드 요구조건의 데이터 흐름상 역할."@ko .
rcpp:requiredProperty a rdf:Property ; rdfs:domain rcpp:FieldRequirement ; rdfs:range rdf:Property ;
    rdfs:label "요구 속성"@ko ; rdfs:comment "클래스별 필드 요구조건이 대상으로 삼는 속성."@ko .
rcpp:requiredForClass a rdf:Property ; rdfs:domain rcpp:FieldRequirement ; rdfs:range rdfs:Class ;
    rdfs:label "요구 적용 클래스"@ko ; rdfs:comment "해당 속성 요구조건이 적용되는 서류내역 클래스."@ko .
rcpp:specificationRequirement a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "규격속성 필요도"@ko ; rdfs:comment "비용 관련 규격속성이 우선 포함인지 계약단가 구분 시 조건부 포함인지 표시한다."@ko .
rcpp:inclusionCondition a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "포함 조건"@ko ; rdfs:comment "규격속성을 분해하여 모델링해야 하는 비용산정상의 조건."@ko .
rcpp:exampleValue a rdf:Property ; rdfs:range rdfs:Literal ;
    rdfs:label "예시값"@ko ; rdfs:comment "속성 정의를 이해하기 위한 대표 값이며 실제 인스턴스 값은 아니다."@ko .
rcpp:applicationCondition a rdf:Property ; rdfs:range rdfs:Literal ;
    rcpp:appliesToClass rcpp:CalculationRule , rcpp:SpecificationNormalizationRule ;
    rdfs:label "적용조건"@ko ; rdfs:comment "계산규칙 또는 정규화 규칙을 적용할 수 있는 업무 조건."@ko .
rcpp:unitCondition a rdf:Property ; rdfs:domain rcpp:CalculationRule ; rdfs:range rdfs:Literal ;
    rdfs:label "단위조건"@ko ; rdfs:comment "계산 입력과 출력에서 충족해야 하는 단위 차원·변환 조건."@ko .
rcpp:processingStage a rdf:Property ; rdfs:domain rcpp:CalculationRule ; rdfs:range rdfs:Literal ;
    rdfs:label "자릿수 처리시점"@ko ; rdfs:comment "수량변환·품목금액·공종합계·총합계 중 반올림 또는 절사를 적용하는 단계."@ko .
rcpp:ruleVersion a rdf:Property ; rdfs:domain rcpp:SpecificationNormalizationRule ; rdfs:range xsd:string ;
    rdfs:label "규칙버전"@ko ; rdfs:comment "정규화 규격코드 생성방식의 변경을 식별하는 버전."@ko .
rcpp:componentOrder a rdf:Property ; rdfs:domain rcpp:SpecificationNormalizationRule ; rdfs:range rdfs:Literal ;
    rdfs:label "규격요소 결합순서"@ko ; rdfs:comment "정규화 규격코드에 포함하는 비용영향 속성과 결합 순서."@ko .
rcpp:componentDelimiter a rdf:Property ; rdfs:domain rcpp:SpecificationNormalizationRule ; rdfs:range xsd:string ;
    rdfs:label "규격코드 구분자"@ko ; rdfs:comment "정규화된 규격요소 사이에 사용하는 문자."@ko .
rcpp:missingValueTreatment a rdf:Property ; rdfs:domain rcpp:SpecificationNormalizationRule ; rdfs:range rdfs:Literal ;
    rdfs:label "누락값 처리"@ko ; rdfs:comment "비용영향 속성값이 없을 때 생략·대체코드·검토대상 중 어떤 방식으로 처리하는지 정의한다."@ko .
rcpp:usesSpecificationRule a rdf:Property ; rdfs:domain rcpp:CostItem ; rdfs:range rcpp:SpecificationNormalizationRule ;
    rdfs:label "규격코드 규칙 사용"@ko ; rdfs:comment "표준 비용항목의 정규화 규격코드를 생성할 때 적용한 공종별 규칙."@ko .

#################################################################
# Document, process and field relationships
#################################################################

rcpp:expectedDocumentRole a rdf:Property ; rdfs:range rcpp:DocumentRole ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "대표 서류역할"@ko ; rdfs:comment "서류 유형 클래스에 일반적으로 기대되는 역할 개체를 연결하는 스키마 주석관계. 실제 프로젝트 서류는 hasDocumentRole을 사용한다."@ko .
rcpp:expectedRequirementTargetClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 필드요구 대상 클래스"@ko ; rdfs:comment "FieldRequirement 개체가 필수·조건부 필드를 지정하는 대상의 공통 상위 클래스를 설명한다."@ko .
rcpp:expectedItemClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 서류내역 클래스"@ko ; rdfs:comment "서류 유형 클래스가 포함할 수 있는 내역의 클래스를 설명하며 실제 서류와 내역의 관계를 단정하지 않는다."@ko .
rcpp:typicalNextDocumentClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "대표 다음 서류유형"@ko ; rdfs:comment "연구 설명을 위한 대표 흐름이며 모든 프로젝트에 고정된 문서 순서를 의미하지 않는다."@ko .
rcpp:schemaFlowsTo a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "스키마상 다음 단계"@ko ; rdfs:comment "문서·매칭·계산 클래스 사이의 개념적 처리 순서를 설명하는 클래스 수준 관계."@ko .
rcpp:expectedCostItemClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 표준 비용항목 클래스"@ko ; rdfs:comment "서류내역 클래스가 인스턴스 수준에서 표현해야 할 표준 비용항목 클래스를 지정한다."@ko .
rcpp:expectedWorkCategoryClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 표준 공종 클래스"@ko ; rdfs:comment "서류내역과 표준 비용항목의 실제 개체가 belongsToWorkCategory로 연결할 표준 공종 클래스."@ko .
rcpp:expectedUnitClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 표준 단위 클래스"@ko ; rdfs:comment "서류내역과 표준 비용항목의 실제 개체가 usesUnit으로 연결할 표준 단위 클래스."@ko .
rcpp:expectedCorrespondingItemClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 대응내역 클래스"@ko ; rdfs:comment "서로 다른 서류의 어떤 내역 클래스끼리 실제 개체 수준에서 대응해야 하는지 설명한다."@ko .
rcpp:expectedUnitPriceSourceClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 계약단가 출처 클래스"@ko ; rdfs:comment "기성 상세내역이 계약단가를 참조해야 할 계약 내역 클래스를 지정한다."@ko .
rcpp:expectedSourceItemClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 파생근거 클래스"@ko ; rdfs:comment "대상 내역값의 실제 개체가 어느 서류내역 클래스의 개체에서 파생되어야 하는지 설명한다."@ko .
rcpp:expectedIdentificationReferenceClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 품목식별 참고 클래스"@ko ; rdfs:comment "금회기성수량의 직접 출처가 아니라 품명·규격·단위와 동일 계약내역 식별에 참고하는 서류내역 클래스."@ko .
rcpp:expectedQuantityBasisClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 계약수량 근거 클래스"@ko ; rdfs:comment "금회기성수량이 아니라 계약수량의 산출근거를 제공하는 수량산출 내역 클래스."@ko .
rcpp:expectedPreviousQuantitySourceClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 전회누계 출처 클래스"@ko ; rdfs:comment "현재 회차의 전회누계기성수량을 이월하는 전회 기성항목 클래스."@ko .
rcpp:expectedAggregationTargetClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 집계대상 클래스"@ko ; rdfs:comment "상세내역 개체가 집계될 결과서류 내부 또는 공종별 집계내역 클래스를 지정한다."@ko .
rcpp:expectedAmountCalculationClass a rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "예상 금액계산 클래스"@ko ; rdfs:comment "결과서류 유형에서 사용하는 기성금액 계산 클래스를 지정한다."@ko .
rcpp:inputQuantityProperty a rdf:Property ; rdfs:domain rdfs:Class ; rdfs:range rdf:Property ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "수량 입력속성"@ko ; rdfs:comment "계산 클래스가 입력으로 요구하는 계약수량·전회누계수량·금회기성수량 속성을 지정한다."@ko .
rcpp:inputUnitPriceProperty a rdf:Property ; rdfs:domain rdfs:Class ; rdfs:range rdf:Property ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "단가 입력속성"@ko ; rdfs:comment "계산 클래스가 입력으로 요구하는 계약단가 속성을 지정한다."@ko .

rcpp:hasDocumentRole a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:DocumentRole ; rcpp:propertyCategory "관계" ;
    rdfs:label "서류역할 보유"@ko ; rdfs:comment "실제 프로젝트 서류 개체가 수행하는 하나 이상의 역할을 연결한다."@ko .
rcpp:containsItem a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "서류 내역 포함"@ko ; rdfs:comment "실제 프로젝트 서류 개체와 그 서류에 포함된 행 개체를 연결한다."@ko .
rcpp:precedesDocument a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:ProgressDocument ; rcpp:propertyCategory "관계" ;
    rdfs:label "실제 다음 서류"@ko ; rdfs:comment "특정 프로젝트에서 실제로 확인된 서류 작성·전달 순서를 연결한다."@ko .
rcpp:producesField a rdf:Property ; rdfs:domain rdfs:Class ; rdfs:range rdf:Property ; rcpp:propertyCategory "관계" ;
    rdfs:label "산출항목 생성"@ko ; rdfs:comment "계산 유형이 산식을 적용하여 생성하는 서류 데이터 항목."@ko .
rcpp:representsCostItem a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:CostItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "표준 비용항목 연결"@ko ; rdfs:comment "실제 서류내역 개체가 어느 표준 비용항목 개체를 표현하는지 연결한다."@ko .
rcpp:correspondsToItem a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "동일 서류내역 대응"@ko ; rdfs:comment "서로 다른 기성서류의 내역이 동일한 표준 비용항목을 표현함을 직접 연결한다."@ko .
rcpp:usesUnitPriceFrom a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:ContractStatementItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "계약단가 참조"@ko ; rdfs:comment "기성 상세내역이 대응 계약내역의 계약단가를 금액 계산에 사용함을 나타낸다. 기성수량 내역에는 사용하지 않는다."@ko .
rcpp:derivedFrom a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "내역값 파생 근거"@ko ; rdfs:comment "목표 서류내역의 값이 어느 원천 서류내역에서 전달·계산되었는지 나타낸다."@ko .
rcpp:identificationReferencedFrom a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "품목식별 참고"@ko ; rdfs:comment "품명·규격·단위와 동일 계약항목을 확인할 때 참고하지만 대상 수량값의 직접 출처로 사용하지 않는 항목 관계."@ko .
rcpp:quantityBasisFrom a rdf:Property ; rdfs:domain rcpp:ContractStatementItem ; rdfs:range rcpp:QuantityCalculationItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "계약수량 산출근거"@ko ; rdfs:comment "계약 내역의 계약수량을 수량산출 내역의 산출수량·산식 근거에 연결한다."@ko .
rcpp:previousQuantityFrom a rdf:Property ; rdfs:domain rcpp:CurrentProgressQuantityItem ; rdfs:range rcpp:PreviousProgressStatementItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "전회누계수량 이월출처"@ko ; rdfs:comment "현재 기성수량 항목의 전회누계기성수량을 전회 기성항목의 확정값에 연결한다."@ko .
rcpp:aggregatedInto a rdf:Property ; rdfs:domain rcpp:DetailCostItem ; rdfs:range rcpp:SummaryCostItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "집계내역으로 합산"@ko ; rdfs:comment "상세내역의 금액이 공종별 집계내역으로 합산되는 관계."@ko .
rcpp:quantityAggregatedInto a rdf:Property ; rdfs:domain rcpp:ProgressQuantityDetailItem ; rdfs:range rcpp:CurrentProgressQuantityItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "기성수량항목으로 합산"@ko ; rdfs:comment "위치·부재별 상세수량행을 동일 계약항목 단위의 금회기성수량 항목으로 합산한다."@ko .
rcpp:inputToCalculationClass a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdfs:Class ; rcpp:propertyCategory "스키마관계" ;
    rdfs:label "금액계산 입력 전달"@ko ; rdfs:comment "금회기성수량 또는 계약단가 속성에서 금회기성금액 계산 클래스로 이어지는 스키마상 입력 흐름."@ko .
rcpp:belongsToWorkCategory a rdf:Property ; rdfs:range rcpp:WorkCategory ;
    rcpp:appliesToClass rcpp:DocumentItem , rcpp:CostItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "공종분류 소속"@ko ; rdfs:comment "서류내역 또는 표준 비용항목을 재사용 가능한 공종분류 자원에 연결한다."@ko .
rcpp:usesUnit a rdf:Property ; rdfs:range rcpp:Unit ;
    rcpp:appliesToClass rcpp:DocumentItem , rcpp:CostItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "측정단위 사용"@ko ; rdfs:comment "서류내역 또는 표준 비용항목의 수량·단가에 적용되는 측정단위 자원을 연결한다."@ko .
rcpp:belongsToProject a rdf:Property ; rdfs:range rcpp:Project ;
    rcpp:appliesToClass rcpp:ProgressDocument , rcpp:ProgressPaymentRound ; rcpp:propertyCategory "관계" ;
    rdfs:label "프로젝트 소속"@ko ; rdfs:comment "실제 기성서류 또는 기성회차를 하나의 프로젝트 문맥에 연결한다."@ko .
rcpp:belongsToProgressRound a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:ProgressPaymentRound ; rcpp:propertyCategory "관계" ;
    rdfs:label "기성회차 소속"@ko ; rdfs:comment "실제 기성서류가 적용되는 기성회차를 연결한다. 계약기준서처럼 여러 회차에 재사용되면 복수 회차에 연결할 수 있다."@ko .
rcpp:previousProgressRound a rdf:Property ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range rcpp:ProgressPaymentRound ; rcpp:propertyCategory "관계" ;
    rdfs:label "이전 기성회차"@ko ; rdfs:comment "전회누계값 이월과 회차 연속성을 확인하기 위한 직전 기성회차 관계."@ko .
rcpp:usesCalculationPolicy a rdf:Property ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range rcpp:CalculationPolicy ; rcpp:propertyCategory "관계" ;
    rdfs:label "금액 계산정책 사용"@ko ; rdfs:comment "기성회차에 적용할 통화·반올림·자릿수·계산순서 정책을 연결한다."@ko .
rcpp:isFirstProgressRound a rdf:Property ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range xsd:boolean ; rcpp:propertyCategory "입력" ;
    rdfs:label "최초 기성회차 여부"@ko ; rdfs:comment "이전 기성회차와 전회 기성서류 없이 전회누계수량·금액을 0으로 적용하는 최초회차인지 표시한다."@ko .
rcpp:hasSourceLocation a rdf:Property ; rdfs:range rcpp:SourceLocation ;
    rcpp:appliesToClass rcpp:ProgressDocument , rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "원천위치 연결"@ko ; rdfs:comment "서류 또는 서류내역을 실제 파일·시트·페이지·행·셀 위치 개체에 연결한다."@ko .
rcpp:sourceItem a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "매칭 원천항목"@ko ; rdfs:comment "매칭 후보를 생성할 때 비교의 출발점이 된 서류내역."@ko .
rcpp:targetItem a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "매칭 대상항목"@ko ; rdfs:comment "원천항목과 동일 비용항목인지 비교하는 대상 서류내역."@ko .
rcpp:matchedCostItem a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range rcpp:CostItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "매칭 표준 비용항목"@ko ; rdfs:comment "두 서류내역이 함께 표현한다고 판단한 표준 비용항목."@ko .
rcpp:matchingMethod a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "매칭 방법"@ko ; rdfs:comment "내역코드 일치·정규화 복합기준 비교·담당자 확인 등 서류내역의 대응관계를 판단한 방법."@ko .
rcpp:matchingEvidence a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range rdfs:Literal ; rcpp:propertyCategory "입력" ;
    rdfs:label "매칭 근거"@ko ; rdfs:comment "코드·품명·규격·단위·공종 일치 등 대응 판단에 사용한 근거."@ko .
rcpp:confidenceScore a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range xsd:decimal ; rcpp:propertyCategory "입력" ;
    rdfs:label "매칭 신뢰도"@ko ; rdfs:comment "0 이상 1 이하로 기록하는 자동 또는 반자동 매칭 후보의 신뢰도."@ko .
rcpp:reviewStatus a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "매칭 검토상태"@ko ; rdfs:comment "후보·승인·반려 등 매칭 결과의 사람 검토 상태."@ko .
rcpp:reviewedBy a rdf:Property ; rdfs:domain rcpp:DocumentItemMatching ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "매칭 검토자"@ko ; rdfs:comment "매칭 결과를 확인하거나 승인한 담당자의 식별자 또는 역할명."@ko .
rcpp:appliesRule a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:CalculationRule ; rcpp:propertyCategory "관계" ;
    rdfs:label "계산규칙 적용"@ko ; rdfs:comment "실제 계산활동에 사용한 재사용 산식 규칙."@ko .
rcpp:appliesPolicy a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:CalculationPolicy ; rcpp:propertyCategory "관계" ;
    rdfs:label "계산정책 적용"@ko ; rdfs:comment "계산활동에 적용한 통화·반올림·절사·계산순서 정책."@ko .
rcpp:calculationRound a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:ProgressPaymentRound ; rcpp:propertyCategory "관계" ;
    rdfs:label "계산 기성회차"@ko ; rdfs:comment "계산활동이 실행된 프로젝트 기성회차."@ko .
rcpp:calculationInputItem a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "계산 입력항목"@ko ; rdfs:comment "실제 계산에 입력된 계약·전회·금회수량 서류내역."@ko .
rcpp:calculationOutputItem a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:DocumentItem ; rcpp:propertyCategory "관계" ;
    rdfs:label "계산 출력항목"@ko ; rdfs:comment "계산결과가 기록된 공사기성부분내역서 등의 서류내역."@ko .
rcpp:calculationStatus a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "계산상태"@ko ; rdfs:comment "대기·완료·오류 등 계산활동의 실행 상태."@ko .
rcpp:usesUnitConversionRule a rdf:Property ; rdfs:domain rcpp:CalculationActivity ; rdfs:range rcpp:UnitConversionRule ; rcpp:propertyCategory "관계" ;
    rdfs:label "단위변환 규칙 사용"@ko ; rdfs:comment "원천수량과 계약단가 기준단위가 다를 때 실제 계산에 적용한 변환규칙."@ko .
rcpp:mapsDirectlyTo a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "그대로 전달"@ko ; rdfs:comment "원천서류의 값을 목표 서류내역으로 직접 전달한다."@ko .
rcpp:matchesWithField a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "매칭 기준"@ko ; rdfs:comment "두 서류의 행이 같은 계약항목인지 확인하는 항목 관계."@ko .
rcpp:calculationInputFor a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "산식 입력"@ko ; rdfs:comment "원천 항목이 대상 계산항목의 산식에 입력되는 영향 관계."@ko .
rcpp:consistencyComparedWith a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "일관성 비교"@ko ; rdfs:comment "서류 간 동일해야 하거나 계산 한계를 비교해야 하는 항목 관계."@ko .
rcpp:aggregatesTo a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "집계 전달"@ko ; rdfs:comment "세부 항목의 값을 공종별 또는 전체 합계 항목으로 합산하여 전달하는 관계."@ko .
rcpp:groupsByField a rdf:Property ; rdfs:domain rdf:Property ; rdfs:range rdf:Property ; rcpp:propertyCategory "항목관계" ;
    rdfs:label "그룹 기준"@ko ; rdfs:comment "공종명처럼 합산하지 않고 여러 상세행을 같은 집계행으로 묶는 분류 기준 항목 관계."@ko .

#################################################################
# Common document metadata
#################################################################

rcpp:projectIdentifier a rdf:Property ; rdfs:domain rcpp:Project ; rdfs:range xsd:string ;
    rcpp:propertyCategory "식별" ; rcpp:graphLevel "core" ; rdfs:label "프로젝트 식별자"@ko ;
    rdfs:comment "서로 다른 프로젝트 개체를 구분하는 기관·사업 기준의 고유 식별 문자열."@ko .
rcpp:projectName a rdf:Property ; rdfs:domain rcpp:Project ; rdfs:range rdfs:Literal ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "프로젝트명"@ko ;
    rdfs:comment "계약·기성서류에서 프로젝트를 표시하는 사업 또는 공사 명칭."@ko .
rcpp:progressRoundNumber a rdf:Property ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range xsd:integer ;
    rcpp:propertyCategory "식별" ; rcpp:graphLevel "core" ; rdfs:label "기성 회차번호"@ko ;
    rdfs:comment "하나의 프로젝트 안에서 기성회차의 순서를 구분하는 정수 번호."@ko .
rcpp:progressRoundReferenceDate a rdf:Property ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range xsd:date ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "기성회차 기준일"@ko ;
    rdfs:comment "해당 기성회차의 수량·금액·누계값을 확정하거나 실적을 집계하는 기준 날짜."@ko .

rcpp:sourceFileName a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "원천 파일명"@ko ; rdfs:comment "값을 추출한 실제 파일의 이름."@ko .
rcpp:sourceSheetName a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "원천 시트명"@ko ; rdfs:comment "스프레드시트에서 값이 위치한 시트 이름."@ko .
rcpp:sourcePageNumber a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:integer ; rcpp:propertyCategory "입력" ;
    rdfs:label "원천 페이지번호"@ko ; rdfs:comment "페이지형 문서에서 값이 위치한 페이지 번호."@ko .
rcpp:sourceRowNumber a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:integer ; rcpp:propertyCategory "입력" ;
    rdfs:label "원천 행번호"@ko ; rdfs:comment "표 또는 스프레드시트에서 값이 위치한 행 번호."@ko .
rcpp:sourceCellRange a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "원천 셀범위"@ko ; rdfs:comment "스프레드시트에서 값이 위치한 셀 또는 셀 범위."@ko .
rcpp:extractionMethod a rdf:Property ; rdfs:domain rcpp:SourceLocation ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "값 기록방법"@ko ; rdfs:comment "원천서류의 값을 온톨로지 데이터에 기록하거나 변환한 방법을 식별하는 설명."@ko .
rcpp:detailLocationText a rdf:Property ; rdfs:domain rcpp:ProgressQuantityDetailItem ; rdfs:range xsd:string ; rcpp:propertyCategory "입력" ;
    rdfs:label "상세 위치문구"@ko ; rdfs:comment "기성수량 상세행을 구분하는 층·구조물·구간·부재 등의 원문 위치정보."@ko .
rcpp:detailCurrentQuantity a rdf:Property ; rdfs:domain rcpp:ProgressQuantityDetailItem ; rdfs:range xsd:decimal ; rcpp:propertyCategory "수량" ;
    rdfs:label "상세 금회기성수량"@ko ; rdfs:comment "하나의 위치·부재별 상세행에 기록된 금회기성수량."@ko ; rcpp:aggregatesTo rcpp:progressCurrentQuantity .

rcpp:documentIdentifier a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:string ;
    rcpp:propertyCategory "식별" ; rcpp:graphLevel "detail" ;
    rdfs:label "문서 식별자"@ko ; rdfs:comment "실제 서류 파일 또는 시트를 구분하는 식별자."@ko .
rcpp:documentName a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "문서명"@ko ; rdfs:comment "실제 서류 또는 시트의 명칭."@ko .
rcpp:documentRevision a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "문서 개정번호"@ko ; rdfs:comment "적용할 서류 버전을 구분하는 개정번호."@ko .
rcpp:documentReferenceDate a rdf:Property ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:date ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "문서 기준일"@ko ; rdfs:comment "계약 또는 기성 회차 적용을 판단하는 기준일."@ko .

#################################################################
# Common document-item attributes
#################################################################

rcpp:hasItemCode a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:string ;
    rcpp:propertyCategory "식별" ; rcpp:graphLevel "detail" ;
    rdfs:label "공통 내역코드"@ko ; rdfs:comment "서류 종류와 관계없이 동일 표준 비용항목을 식별하기 위한 공통 코드 속성. 각 서류의 원천 코드 속성은 이 속성의 하위속성으로 둔다."@ko .
rcpp:hasSourceWorkCategoryText a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "원문 공종문구"@ko ; rdfs:comment "프로젝트 서류에 적힌 공종 문자열을 손실 없이 보존하는 공통 상위 속성. 정규화된 표준 공종은 belongsToWorkCategory로 연결한다."@ko .
rcpp:hasItemName a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "공통 품명"@ko ; rdfs:comment "서류별 품명·공사내역 문자열을 공통 의미로 조회하기 위한 상위 속성."@ko .
rcpp:hasSpecificationText a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "공통 규격문구"@ko ; rdfs:comment "각 기성서류에 기록된 원문 규격문구의 공통 상위 속성. 계약단가 식별용 규격 개념과 원문 문자열을 구분한다."@ko .
rcpp:hasSourceUnitText a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:string ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "원문 단위문구"@ko ; rdfs:comment "M2·m²·㎡처럼 프로젝트 서류에 적힌 단위 문자열을 보존하는 공통 상위 속성. 정규화된 표준 단위는 usesUnit으로 연결한다."@ko .
rcpp:hasQuantityValue a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:decimal ;
    rcpp:propertyCategory "수량" ; rcpp:graphLevel "detail" ;
    rdfs:label "공통 수량값"@ko ; rdfs:comment "계약·전회·금회·누계·잔여 등 서류별 수량 속성을 포괄하는 공통 상위 속성."@ko .
rcpp:hasUnitPriceValue a rdf:Property ; rdfs:domain rcpp:DocumentItem ; rdfs:range xsd:decimal ;
    rcpp:propertyCategory "단가" ; rcpp:graphLevel "detail" ;
