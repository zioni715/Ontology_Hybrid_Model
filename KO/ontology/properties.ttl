    rdfs:label "진동기 사용 여부"@ko ; rdfs:comment "타설 작업에 진동기를 사용하는지 여부."@ko .
rcpp:placementCondition a rdf:Property ; rdfs:domain rcpp:ConcretePlacementCostItem ; rdfs:range xsd:string ;
