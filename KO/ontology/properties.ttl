# Extended calculation values used for automation and future form expansion.
rcpp:outputCumulativeQuantity a rdf:Property ; rdfs:domain rcpp:CurrentProgressDetailItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 16 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaCategory "직접 전달" ; rcpp:formulaExpression "출력 누계기성수량 = 기성수량산출서 누계기성수량 직접 전달"@ko ;
    rcpp:crossCheckFormulaExpression "교차검토값 = 전회누계기성수량 + 금회기성수량"@ko ;
    rdfs:label "누계기성수량"@ko ; rdfs:comment "기성수량산출서의 누계기성수량을 기준값으로 직접 전달하고 전회수량과 금회수량의 합은 교차검토에만 사용한다."@ko .
rcpp:outputCumulativeAmount a rdf:Property ; rdfs:domain rcpp:CurrentProgressDetailItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 17 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "계산" ;
    rcpp:formulaCategory "기본" ; rcpp:formulaExpression "누계기성금액 = 전회누계기성금액 + 금회기성금액"@ko ;
    rcpp:calculationInputFor rcpp:outputCumulativeRate , rcpp:outputRemainingAmount ;
    rdfs:label "누계기성금액"@ko ; rdfs:comment "전회누계기성금액과 금회기성금액의 합."@ko .
rcpp:outputCumulativeRate a rdf:Property ; rdfs:domain rcpp:CurrentProgressDetailItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 18 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "계산" ;
    rcpp:formulaCategory "기본" ; rcpp:formulaExpression "누계기성비율(%) = 누계기성금액 ÷ 계약금액 × 100"@ko ;
    rdfs:label "누계기성비율(%)"@ko ; rdfs:comment "누계기성금액의 계약금액 대비 비율."@ko .
rcpp:outputRemainingQuantity a rdf:Property ; rdfs:domain rcpp:CurrentProgressDetailItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 19 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "출력" ;
    rcpp:formulaCategory "직접 전달" ; rcpp:formulaExpression "출력 잔여수량 = 기성수량산출서 잔여수량 직접 전달"@ko ;
    rcpp:crossCheckFormulaExpression "교차검토값 = 계약수량 − 누계기성수량"@ko ;
    rdfs:label "잔여수량"@ko ; rdfs:comment "기성수량산출서의 잔여수량을 기준값으로 직접 전달하고 계약수량에서 누계기성수량을 뺀 값은 교차검토에만 사용한다."@ko .
rcpp:outputRemainingAmount a rdf:Property ; rdfs:domain rcpp:CurrentProgressDetailItem ; rdfs:range xsd:decimal ;
    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 20 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "계산" ;
    rcpp:formulaCategory "기본" ; rcpp:formulaExpression "잔여금액 = 계약금액 − 누계기성금액"@ko ;
    rdfs:label "잔여금액"@ko ; rdfs:comment "계약금액에서 누계기성금액을 뺀 값."@ko .

# Current progress-statement internal summary rows.
rcpp:outputSummaryWorkCategoryText a rdf:Property ; rdfs:domain rcpp:CurrentProgressSummaryItem ; rdfs:range xsd:string ;
    rdfs:subPropertyOf rcpp:hasSourceWorkCategoryText ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ;
    rcpp:fieldOrder 25 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ; rcpp:sourceFieldLabel "공종"@ko ;
    rdfs:label "집계행 원문 공종문구"@ko ; rdfs:comment "결과서류 내부 집계행에 표시되는 원문 공종명. 표준 공종은 belongsToWorkCategory로 연결한다."@ko .
