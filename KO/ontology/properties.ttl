    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 13 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "계산" ; rcpp:outputColumnGroup "금회기성액/금액" ;
