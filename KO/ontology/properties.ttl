# Shared application-part and vertical-height specification factors
rcpp:applicationPart a rdf:Property ; rdfs:range xsd:string ;
    rcpp:appliesToClass rcpp:ConcretePlacementCostItem , rcpp:FormworkCostItem , rcpp:ShoringCostItem ;
