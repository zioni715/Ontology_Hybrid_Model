    rdfs:subPropertyOf rcpp:hasAmountValue ; rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 30 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ;
    rdfs:label "철근콘크리트공사 금회기성금액"@ko ; rdfs:comment "철근·콘크리트·거푸집·동바리의 공종별 금회기성금액 합계."@ko .

#################################################################
# Standard cost-item fields
# These are canonical values used across documents. They are shown
# in the side panel of the cost-item class, not as graph field nodes.
#################################################################

