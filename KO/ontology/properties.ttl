    rdfs:label "적용부위"@ko ; rdfs:comment "비용산정 작업이 적용되는 구조부위."@ko .
rcpp:minimumVerticalHeight a rdf:Property ; rdfs:range xsd:decimal ;
    rcpp:appliesToClass rcpp:FormworkCostItem , rcpp:ShoringCostItem ;
    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ; rcpp:specificationRequirement "조건부" ;
    rcpp:inclusionCondition "수직고구간의 하한을 수치로 비교해야 하는 경우"@ko ;
    rcpp:exampleValue "7 m 초과"@ko ;
    rdfs:label "최소수직고(m)"@ko ; rdfs:comment "단가가 적용되는 수직고구간의 최솟값."@ko .
rcpp:maximumVerticalHeight a rdf:Property ; rdfs:range xsd:decimal ;
    rcpp:appliesToClass rcpp:FormworkCostItem , rcpp:ShoringCostItem ;
    rcpp:graphLevel "detail" ; rcpp:propertyCategory "식별" ; rcpp:specificationRequirement "우선 포함" ;
    rcpp:exampleValue "7 m 이하"@ko ;
    rdfs:label "최대수직고(m)"@ko ; rdfs:comment "단가가 적용되는 수직고구간의 최댓값."@ko .
rcpp:verticalHeightBand a rdf:Property ; rdfs:range xsd:string ;
