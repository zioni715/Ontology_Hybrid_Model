rcpp:baseUnit a rdf:Property ; rdfs:domain rcpp:Unit ; rdfs:range rcpp:Unit ;
    rcpp:propertyCategory "관계" ; rcpp:graphLevel "core" ; rdfs:label "기준단위"@ko ;
    rdfs:comment "동일 차원 단위를 비교·변환할 때 사용하는 기준단위."@ko .
rcpp:conversionFactorToBaseUnit a rdf:Property ; rdfs:domain rcpp:Unit ; rdfs:range xsd:decimal ;
    rcpp:propertyCategory "계산" ; rcpp:graphLevel "core" ; rdfs:label "기준단위 변환계수"@ko ;
    rdfs:comment "현재 단위의 수량에 곱하여 기준단위 수량으로 바꾸는 계수. 예: 1 ton × 1000 = 1000 kg."@ko .
rcpp:codeValue a rdf:Property ; rdfs:range xsd:string ;
    rcpp:appliesToClass rcpp:ControlledSpecificationValue , rcpp:Currency , rcpp:RoundingMode ;
    rcpp:propertyCategory "식별" ; rcpp:graphLevel "detail" ; rdfs:label "표준 코드값"@ko ;
    rdfs:comment "통제 규격값·통화·반올림 방식 개체를 언어와 무관하게 식별하는 기계가독형 코드."@ko .
rcpp:sourceValueAlias a rdf:Property ; rdfs:range xsd:string ;
    rcpp:appliesToClass rcpp:ControlledSpecificationValue , rcpp:WorkCategory , rcpp:Unit ; rcpp:propertyCategory "입력" ; rcpp:graphLevel "detail" ;
    rdfs:label "원문 값 별칭"@ko ; rdfs:comment "프로젝트 원문에서 같은 표준 범주값으로 매핑되는 철자·언어·표현 변형."@ko .
rcpp:currency a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range rcpp:Currency ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "통화"@ko ;
    rdfs:comment "금액 계산·반올림·허용오차 해석에 적용할 통화 개체를 계산정책에 연결한다."@ko .
rcpp:roundingMode a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range rcpp:RoundingMode ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "반올림 방식"@ko ;
    rdfs:comment "계산된 금액의 지정 자릿수 이하를 반올림·절사·올림 처리하는 방식."@ko .
rcpp:decimalScale a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range xsd:integer ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "금액 소수점 자릿수"@ko ;
    rdfs:comment "반올림 방식을 적용한 후 금액에 유지할 소수점 이하 자릿수. 0은 통화의 정수 단위까지 처리함을 뜻한다."@ko .
rcpp:calculationOrder a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range rdfs:Literal ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "계산순서"@ko ;
    rdfs:comment "항목별 자릿수 처리 후 합계 또는 합계 후 자릿수 처리처럼 금액 오차에 영향을 주는 순서."@ko .
rcpp:amountTolerance a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range xsd:decimal ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "금액 허용오차"@ko ;
    rdfs:comment "기록 금액과 교차계산 금액을 비교할 때 허용하는 통화단위 기준 차이."@ko .
rcpp:quantityTolerance a rdf:Property ; rdfs:domain rcpp:CalculationPolicy ; rdfs:range xsd:decimal ;
    rcpp:propertyCategory "입력" ; rcpp:graphLevel "core" ; rdfs:label "수량 허용오차"@ko ;
    rdfs:comment "단위변환 또는 소수 자릿수 차이로 발생하는 수량 비교 허용범위."@ko .
