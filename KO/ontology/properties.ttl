rcpp:supportItemName a rdf:Property ; rdfs:domain rcpp:SupportingReferenceItem ; rdfs:range xsd:string ;
    rcpp:fieldOfDocument rcpp:SupportingReferenceDocument ; rcpp:fieldOrder 3 ; rcpp:graphLevel "extended" ; rcpp:propertyCategory "입력" ;
