    rcpp:fieldOfDocument rcpp:CurrentProgressStatement ; rcpp:fieldOrder 11 ; rcpp:graphLevel "core" ; rcpp:propertyCategory "출력" ; rcpp:outputColumnGroup "전회까지의 기성액/금액" ;
    rcpp:formulaCategory "직접 전달" ; rcpp:formulaExpression "전회누계기성금액 = 전회 공사기성부분내역서의 확정 누계금액 이월"@ko ;
    rcpp:crossCheckFormulaExpression "교차검토값 = 전회누계기성수량 × 계약단가"@ko ;
    rcpp:calculationInputFor rcpp:outputPreviousRate , rcpp:outputCumulativeAmount ;
    rdfs:label "전회누계기성금액"@ko ; rdfs:comment "전회 누계금액을 전달하고 전회 누계수량과 계약단가로 교차계산하는 값."@ko .
