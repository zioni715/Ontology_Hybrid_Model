# Git에는 메인 안내문, KO 온톨로지와 시각화만 포함한다.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/KO/

# KO 폴더 안에서는 온톨로지 원본과 재현 가능한 시각화만 추적한다.
/KO/*
!/KO/ontology/
!/KO/visualization/

# 생성 과정에서 생기는 캐시는 추적하지 않는다.
**/__pycache__/
*.py[cod]

# 온톨로지 명세서 생성용 로컬 스크립트는 추적하지 않는다.
/KO/ontology/generate_specification.py
