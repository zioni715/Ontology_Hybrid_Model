@prefix pcpo: <https://example.org/pcpo#> .
@prefix ex: <https://example.org/pcpo/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Dataset declaration: intentionally invalid synthetic example data
#################################################################

ex:sample-invalid
    a rdfs:Resource ;
    rdfs:label "의도적 오류 합성 예제 데이터"@ko , "Intentionally invalid synthetic example data"@en ;
    rdfs:comment "각 SPARQL 검증규칙의 오류 검출을 시험하기 위해 정상 예제 그래프 위에 추가하는 synthetic example data."@ko .

ex:invalid-qto-document
    a pcpo:CurrentProgressQTO ;
    pcpo:documentIdentifier "SYNTH-INVALID-QTO" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine ex:invalid-missing-contract , ex:invalid-name-mismatch , ex:invalid-spec-mismatch , ex:invalid-unit-mismatch .

ex:invalid-progress-document
    a pcpo:CurrentProgressStatement ;
    pcpo:documentIdentifier "SYNTH-INVALID-PROGRESS" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine
        ex:invalid-unit-price , ex:invalid-previous-values , ex:invalid-cumulative-quantity ,
        ex:invalid-contract-exceeded , ex:invalid-remaining-quantity , ex:invalid-current-amount ,
        ex:invalid-cumulative-amount , ex:invalid-missing-required .

ex:invalid-summary-document
    a pcpo:WorkSummaryDocument ;
    pcpo:documentIdentifier "SYNTH-INVALID-SUMMARY" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine ex:invalid-summary-rebar .

#################################################################
# V01: missing contract item
#################################################################

ex:invalid-missing-contract
    a pcpo:QuantityCalculationLine ;
    pcpo:lineIdentifier "INVALID-V01" ;
    pcpo:contractItemCode "XX-404" ;
    pcpo:itemName "Unmapped synthetic item" ;
    pcpo:specificationText "No matching contract item" ;
    pcpo:hasUnit pcpo:Unit-M2 ;
    pcpo:currentProgressQuantityValue "10"^^xsd:decimal ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:recordedIn ex:invalid-qto-document .

#################################################################
# V02: duplicate contract item code in one contract version
#################################################################

ex:invalid-duplicate-contract-item
    a pcpo:RebarWorkItem ;
    pcpo:belongsToContractVersion ex:contract-version-2 ;
    pcpo:classifiedAsWorkType pcpo:RebarWorkItem ;
    pcpo:contractItemCode "RB-001" ;
    pcpo:itemName "Duplicate synthetic rebar item" ;
    pcpo:specificationText "SD400 D13" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:contractQuantityValue "1"^^xsd:decimal ;
    pcpo:contractUnitPriceValue "1"^^xsd:decimal ;
    pcpo:contractAmountValue "1"^^xsd:decimal .

#################################################################
# V03-V05: document-to-contract mismatches
#################################################################

ex:invalid-name-mismatch
    a pcpo:QuantityCalculationLine ;
    pcpo:lineIdentifier "INVALID-V03" ;
    pcpo:contractItemCode "RB-001" ;
    pcpo:itemName "Incorrect item name" ;
    pcpo:specificationText "SD400 D13" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:basedOnContractItem ex:item-v2-RB01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:recordedIn ex:invalid-qto-document .

ex:invalid-spec-mismatch
    a pcpo:QuantityCalculationLine ;
    pcpo:lineIdentifier "INVALID-V04" ;
    pcpo:contractItemCode "RB-001" ;
    pcpo:itemName "Rebar fabrication and assembly" ;
    pcpo:specificationText "SD400 D22" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:basedOnContractItem ex:item-v2-RB01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:recordedIn ex:invalid-qto-document .

ex:invalid-unit-mismatch
    a pcpo:QuantityCalculationLine ;
    pcpo:lineIdentifier "INVALID-V05" ;
    pcpo:contractItemCode "RB-001" ;
    pcpo:itemName "Rebar fabrication and assembly" ;
    pcpo:specificationText "SD400 D13" ;
    pcpo:hasUnit pcpo:Unit-M2 ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:basedOnContractItem ex:item-v2-RB01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:recordedIn ex:invalid-qto-document .

#################################################################
# V06: applied unit price differs from the effective contract item
#################################################################

ex:invalid-unit-price
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V06" ;
    pcpo:contractItemCode "RB-001" ;
    pcpo:itemName "Rebar fabrication and assembly" ;
    pcpo:specificationText "SD400 D13" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:basedOnContractItem ex:item-v2-RB01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "20"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "21"^^xsd:decimal ;
    pcpo:remainingQuantityValue "89"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "999999"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "24000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "1250000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "25250000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V07: carried-forward values differ from approved values
#################################################################

ex:invalid-previous-values
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V07" ;
    pcpo:contractItemCode "RB-002" ;
    pcpo:itemName "Rebar fabrication and assembly" ;
    pcpo:specificationText "SD400 D16" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:basedOnContractItem ex:item-v2-RB02 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:carriedForwardFrom ex:approved-r1-RB02 ;
    pcpo:previousCumulativeQuantityValue "14"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "15"^^xsd:decimal ;
    pcpo:remainingQuantityValue "75"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "1350000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "18000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "1350000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "19350000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V08: cumulative quantity calculation error
#################################################################

ex:invalid-cumulative-quantity
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V08" ;
    pcpo:contractItemCode "CO-001" ;
    pcpo:itemName "Reinforced concrete placement" ;
    pcpo:specificationText "Ready-mixed concrete 24 MPa / 25 mm / 150 mm" ;
    pcpo:hasUnit pcpo:Unit-M3 ;
    pcpo:basedOnContractItem ex:item-v2-CO01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "200"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "202"^^xsd:decimal ;
    pcpo:remainingQuantityValue "998"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "105000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "20000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "105000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "20105000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V09: cumulative quantity exceeds the contract quantity
#################################################################

ex:invalid-contract-exceeded
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V09" ;
    pcpo:contractItemCode "CO-002" ;
    pcpo:itemName "Reinforced concrete placement" ;
    pcpo:specificationText "Ready-mixed concrete 27 MPa / 25 mm / 150 mm" ;
    pcpo:hasUnit pcpo:Unit-M3 ;
    pcpo:basedOnContractItem ex:item-v2-CO02 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "100"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "801"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "901"^^xsd:decimal ;
    pcpo:remainingQuantityValue "-1"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "115000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "11000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "92115000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "103115000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V10: remaining quantity calculation error
#################################################################

ex:invalid-remaining-quantity
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V10" ;
    pcpo:contractItemCode "FW-001" ;
    pcpo:itemName "Plywood formwork installation and removal" ;
    pcpo:specificationText "Plywood formwork / foundation side" ;
    pcpo:hasUnit pcpo:Unit-M2 ;
    pcpo:basedOnContractItem ex:item-v2-FW01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "1000"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "1001"^^xsd:decimal ;
    pcpo:remainingQuantityValue "999"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "37000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "35000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "37000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "35037000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V11: current progress amount calculation error
#################################################################

ex:invalid-current-amount
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V11" ;
    pcpo:contractItemCode "FW-002" ;
    pcpo:itemName "Euroform installation and removal" ;
    pcpo:specificationText "Euroform / wall" ;
    pcpo:hasUnit pcpo:Unit-M2 ;
    pcpo:basedOnContractItem ex:item-v2-FW02 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "600"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "601"^^xsd:decimal ;
    pcpo:remainingQuantityValue "2699"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "47000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "27000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "1"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "27000001"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V12: cumulative amount calculation error
#################################################################

ex:invalid-cumulative-amount
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V12" ;
    pcpo:contractItemCode "SH-001" ;
    pcpo:itemName "System shoring installation and removal" ;
    pcpo:specificationText "System shoring / height 3-5 m" ;
    pcpo:hasUnit pcpo:Unit-SPACE-M3 ;
    pcpo:basedOnContractItem ex:item-v2-SH01 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "2000"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "2001"^^xsd:decimal ;
    pcpo:remainingQuantityValue "8999"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "13000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "24000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "13000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "24000000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V13: recorded summary differs from the sum of aggregated items
#################################################################

ex:invalid-summary-rebar
    a pcpo:ProgressSummary ;
    pcpo:lineIdentifier "INVALID-V13" ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:summarizesWorkType pcpo:RebarWorkItem ;
    pcpo:aggregates ex:progress-r2-RB01 , ex:progress-r2-RB02 ;
    pcpo:aggregatedCurrentAmountValue "58000000"^^xsd:decimal ;
    pcpo:calculatedBy pcpo:SubworkSummaryRule ;
    pcpo:recordedIn ex:invalid-summary-document .

#################################################################
# V14: required document values are missing
#################################################################

ex:invalid-missing-required
    a pcpo:CurrentProgressLine ;
    pcpo:lineIdentifier "INVALID-V14" ;
    pcpo:contractItemCode "SH-002" ;
    pcpo:specificationText "Pipe support / height under 3 m" ;
    pcpo:basedOnContractItem ex:item-v2-SH02 ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:previousCumulativeQuantityValue "800"^^xsd:decimal ;
    pcpo:currentProgressQuantityValue "1"^^xsd:decimal ;
    pcpo:cumulativeQuantityValue "801"^^xsd:decimal ;
    pcpo:remainingQuantityValue "3699"^^xsd:decimal ;
    pcpo:appliedContractUnitPriceValue "16000"^^xsd:decimal ;
    pcpo:previousCumulativeAmountValue "12000000"^^xsd:decimal ;
    pcpo:currentProgressAmountValue "16000"^^xsd:decimal ;
    pcpo:cumulativeAmountValue "12016000"^^xsd:decimal ;
    pcpo:recordedIn ex:invalid-progress-document .

#################################################################
# V15: negative contract values
#################################################################

ex:invalid-negative-contract-item
    a pcpo:RebarWorkItem ;
    pcpo:belongsToContractVersion ex:contract-version-2 ;
    pcpo:classifiedAsWorkType pcpo:RebarWorkItem ;
    pcpo:contractItemCode "NEG-001" ;
    pcpo:itemName "Negative synthetic item" ;
    pcpo:specificationText "Intentional negative values" ;
    pcpo:hasUnit pcpo:Unit-TON ;
    pcpo:contractQuantityValue "-1"^^xsd:decimal ;
    pcpo:contractUnitPriceValue "-1"^^xsd:decimal ;
    pcpo:contractAmountValue "-1"^^xsd:decimal .
