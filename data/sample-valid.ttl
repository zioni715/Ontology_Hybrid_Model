@prefix pcpo: <https://example.org/pcpo#> .
@prefix ex: <https://example.org/pcpo/resource/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Dataset declaration: synthetic example data
#################################################################

ex:sample-valid
    a rdfs:Resource ;
    rdfs:label "정상 합성 예제 데이터"@ko , "Valid synthetic example data"@en ;
    rdfs:comment "실제 공공공사 자료가 아닌 온톨로지와 SPARQL 실행 검증용 synthetic example data."@ko .

#################################################################
# Project, contract versions, and progress rounds
#################################################################

ex:project-demo
    a pcpo:ConstructionProject ;
    pcpo:projectIdentifier "SYNTH-PROJECT-001" ;
    rdfs:label "가상 공공청사 신축공사"@ko , "Synthetic Public Building Project"@en .

ex:contract-demo
    a pcpo:Contract ;
    pcpo:contractIdentifier "SYNTH-CONTRACT-001" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasContractVersion ex:contract-version-1 , ex:contract-version-2 .

ex:contract-version-1
    a pcpo:InitialContractVersion ;
    pcpo:contractVersionNumber 1 ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:validFrom "2026-01-01"^^xsd:date ;
    pcpo:validTo "2026-03-31"^^xsd:date ;
    pcpo:hasContractItem
        ex:item-v1-RB01 , ex:item-v1-RB02 , ex:item-v1-CO01 , ex:item-v1-CO02 ,
        ex:item-v1-FW01 , ex:item-v1-FW02 , ex:item-v1-SH01 , ex:item-v1-SH02 .

ex:contract-version-2
    a pcpo:RevisedContractVersion ;
    pcpo:contractVersionNumber 2 ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:supersedes ex:contract-version-1 ;
    pcpo:validFrom "2026-04-01"^^xsd:date ;
    pcpo:validTo "2026-12-31"^^xsd:date ;
    pcpo:hasContractItem
        ex:item-v2-RB01 , ex:item-v2-RB02 , ex:item-v2-CO01 , ex:item-v2-CO02 ,
        ex:item-v2-FW01 , ex:item-v2-FW02 , ex:item-v2-SH01 , ex:item-v2-SH02 .

ex:progress-round-1
    a pcpo:ProgressPeriod ;
    pcpo:progressRoundNumber 1 ;
    pcpo:progressReferenceDate "2026-03-31"^^xsd:date ;
    rdfs:label "제1회 기성"@ko , "Progress Round 1"@en .

ex:progress-round-2
    a pcpo:ProgressPeriod ;
    pcpo:progressRoundNumber 2 ;
    pcpo:progressReferenceDate "2026-06-30"^^xsd:date ;
    rdfs:label "제2회 기성"@ko , "Progress Round 2"@en .

ex:progress-claim-1
    a pcpo:ProgressClaim ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:hasProgressRound ex:progress-round-1 ;
    pcpo:isApproved true ;
    pcpo:hasProgressClaimItem
        ex:progress-r1-RB01 , ex:progress-r1-RB02 , ex:progress-r1-CO01 , ex:progress-r1-CO02 ,
        ex:progress-r1-FW01 , ex:progress-r1-FW02 , ex:progress-r1-SH01 , ex:progress-r1-SH02 .

ex:progress-claim-2
    a pcpo:ProgressClaim ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:isApproved false ;
    pcpo:hasProgressClaimItem
        ex:progress-r2-RB01 , ex:progress-r2-RB02 , ex:progress-r2-CO01 , ex:progress-r2-CO02 ,
        ex:progress-r2-FW01 , ex:progress-r2-FW02 , ex:progress-r2-SH01 , ex:progress-r2-SH02 .

#################################################################
# Documents
#################################################################

ex:contract-boq-v1
    a pcpo:ContractBOQ ;
    pcpo:documentIdentifier "SYNTH-BOQ-V1" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:hasDocumentLine
        ex:contract-line-v1-RB01 , ex:contract-line-v1-RB02 , ex:contract-line-v1-CO01 , ex:contract-line-v1-CO02 ,
        ex:contract-line-v1-FW01 , ex:contract-line-v1-FW02 , ex:contract-line-v1-SH01 , ex:contract-line-v1-SH02 .

ex:contract-boq-v2
    a pcpo:RevisedContractBOQ ;
    pcpo:documentIdentifier "SYNTH-BOQ-V2" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:belongsToContract ex:contract-demo ;
    pcpo:hasDocumentLine
        ex:contract-line-v2-RB01 , ex:contract-line-v2-RB02 , ex:contract-line-v2-CO01 , ex:contract-line-v2-CO02 ,
        ex:contract-line-v2-FW01 , ex:contract-line-v2-FW02 , ex:contract-line-v2-SH01 , ex:contract-line-v2-SH02 .

ex:qto-round-1
    a pcpo:CurrentProgressQTO ;
    pcpo:documentIdentifier "SYNTH-QTO-R1" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-1 ;
    pcpo:hasDocumentLine
        ex:qto-r1-RB01 , ex:qto-r1-RB02 , ex:qto-r1-CO01 , ex:qto-r1-CO02 ,
        ex:qto-r1-FW01 , ex:qto-r1-FW02 , ex:qto-r1-SH01 , ex:qto-r1-SH02 .

ex:current-statement-round-1
    a pcpo:CurrentProgressStatement ;
    pcpo:documentIdentifier "SYNTH-PROGRESS-R1" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-1 ;
    pcpo:hasDocumentLine
        ex:progress-r1-RB01 , ex:progress-r1-RB02 , ex:progress-r1-CO01 , ex:progress-r1-CO02 ,
        ex:progress-r1-FW01 , ex:progress-r1-FW02 , ex:progress-r1-SH01 , ex:progress-r1-SH02 .

ex:qto-round-2
    a pcpo:CurrentProgressQTO ;
    pcpo:documentIdentifier "SYNTH-QTO-R2" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine
        ex:qto-r2-RB01 , ex:qto-r2-RB02 , ex:qto-r2-CO01 , ex:qto-r2-CO02 ,
        ex:qto-r2-FW01 , ex:qto-r2-FW02 , ex:qto-r2-SH01 , ex:qto-r2-SH02 .

ex:previous-approved-statement-round-1
    a pcpo:PreviousApprovedProgressStatement ;
    pcpo:documentIdentifier "SYNTH-PREV-APPROVED-R1" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-1 ;
    pcpo:hasDocumentLine
        ex:approved-r1-RB01 , ex:approved-r1-RB02 , ex:approved-r1-CO01 , ex:approved-r1-CO02 ,
        ex:approved-r1-FW01 , ex:approved-r1-FW02 , ex:approved-r1-SH01 , ex:approved-r1-SH02 .

ex:current-statement-round-2
    a pcpo:CurrentProgressStatement ;
    pcpo:documentIdentifier "SYNTH-PROGRESS-R2" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine
        ex:progress-r2-RB01 , ex:progress-r2-RB02 , ex:progress-r2-CO01 , ex:progress-r2-CO02 ,
        ex:progress-r2-FW01 , ex:progress-r2-FW02 , ex:progress-r2-SH01 , ex:progress-r2-SH02 .

ex:work-summary-round-2
    a pcpo:WorkSummaryDocument ;
    pcpo:documentIdentifier "SYNTH-SUMMARY-R2" ;
    pcpo:belongsToProject ex:project-demo ;
    pcpo:hasProgressRound ex:progress-round-2 ;
    pcpo:hasDocumentLine ex:summary-r2-rebar , ex:summary-r2-concrete , ex:summary-r2-formwork , ex:summary-r2-shoring , ex:summary-r2-rc .

#################################################################
# Specifications, locations, and structural members
#################################################################

ex:spec-RB01 a pcpo:Specification ; pcpo:specificationText "SD400 D13" ; pcpo:steelGrade "SD400" .
ex:spec-RB02 a pcpo:Specification ; pcpo:specificationText "SD400 D16" ; pcpo:steelGrade "SD400" .
ex:spec-CO01 a pcpo:Specification ; pcpo:specificationText "Ready-mixed concrete 24 MPa / 25 mm / 150 mm" ; pcpo:concreteType "Ready-mixed concrete" ; pcpo:designStrengthValue "24"^^xsd:decimal ; pcpo:maxAggregateSizeValue "25"^^xsd:decimal ; pcpo:slumpValue "150"^^xsd:decimal .
ex:spec-CO02 a pcpo:Specification ; pcpo:specificationText "Ready-mixed concrete 27 MPa / 25 mm / 150 mm" ; pcpo:concreteType "Ready-mixed concrete" ; pcpo:designStrengthValue "27"^^xsd:decimal ; pcpo:maxAggregateSizeValue "25"^^xsd:decimal ; pcpo:slumpValue "150"^^xsd:decimal .
ex:spec-FW01 a pcpo:Specification ; pcpo:specificationText "Plywood formwork / foundation side" ; pcpo:formworkType "Plywood formwork" ; pcpo:applicableMemberText "Foundation side" .
ex:spec-FW02 a pcpo:Specification ; pcpo:specificationText "Euroform / wall" ; pcpo:formworkType "Euroform" ; pcpo:applicableMemberText "Wall" .
ex:spec-SH01 a pcpo:Specification ; pcpo:specificationText "System shoring / height 3-5 m" ; pcpo:shoringType "System shoring" ; pcpo:heightRangeText "3-5 m" ; pcpo:calculationBasisType "spatial volume" .
ex:spec-SH02 a pcpo:Specification ; pcpo:specificationText "Pipe support / height under 3 m" ; pcpo:shoringType "Pipe support" ; pcpo:heightRangeText "under 3 m" ; pcpo:calculationBasisType "area" .

ex:location-zone-a a pcpo:ConstructionLocation ; pcpo:locationName "Building A / foundation zone" .
ex:location-zone-b a pcpo:ConstructionLocation ; pcpo:locationName "Building A / basement zone" .
ex:member-foundation a pcpo:StructuralMember ; pcpo:memberName "Foundation" .
ex:member-wall a pcpo:StructuralMember ; pcpo:memberName "Wall" .
ex:member-slab a pcpo:StructuralMember ; pcpo:memberName "Slab" .
ex:member-column a pcpo:StructuralMember ; pcpo:memberName "Column" .

